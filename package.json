{
  "name": "antidark",
  "version": "1.0.0",
  "description": "Darkgrid RPG — Main Game (3 Regions + 2 Large Dungeons) & Preserved Legacy Game",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:legacy": "node legacy-game/server.js",
    "dev:legacy": "node --watch legacy-game/server.js",
    "start:lab": "node src/server.js",
    "dev:lab": "node --watch src/server.js",
    "test": "node --require ./tests/test_helpers.js --test tests/*.test.js action-ui-lab/tests/phase-6-1-hardening.test.js action-ui-lab/tests/phase-6-legacy-integration.test.js action-ui-lab/tests/phase8-world-and-systems.test.js action-ui-lab/tests/phase9b-world-expansion.test.js action-ui-lab/tests/phase9c-dungeons-and-highlands.test.js action-ui-lab/tests/topdown-experiment.test.js",
    "test:legacy": "node --require ./legacy-game/tests/test_helpers.js --test legacy-game/tests/*.test.js",
    "test:lab": "node --test action-ui-lab/tests/phase8-world-and-systems.test.js action-ui-lab/tests/phase9b-world-expansion.test.js action-ui-lab/tests/phase9c-dungeons-and-highlands.test.js action-ui-lab/tests/topdown-experiment.test.js",
    "db:setup": "node scripts/setup_db.js",
    "setup:db": "node scripts/setup_db.js",
    "db:world": "node scripts/generate_world_seed.js",
    "backup:db": "node scripts/backup_database.js",
    "restore:db": "node scripts/restore_database.js",
    "migrate:firestore": "node scripts/migrate_from_firestore.js",
    "deploy:blaze": "node scripts/deploy_blaze.js",
    "build:firebase": "node scripts/build_firebase.js",
    "deploy:firebase": "node scripts/build_firebase.js && npx -y firebase-tools@latest deploy --project darkgrid-rpg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "firebase": "^13.0.0",
    "sql.js": "^1.14.2"
  }
}
