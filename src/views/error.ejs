<%- include('partials/header') %>

<div class="auth-wrapper">
  <div class="auth-container error-container">
    <div class="auth-corner top-left"></div>
    <div class="auth-corner top-right"></div>
    <div class="auth-corner bottom-left"></div>
    <div class="auth-corner bottom-right"></div>

    <div class="error-emblem">💀</div>
    <h1 class="card-title error-title"><%= title %></h1>
    <p class="error-message"><%= message %></p>
    <a href="/" class="btn btn-primary btn-error-return">Return to the Game</a>
  </div>
</div>

<%- include('partials/footer') %>
