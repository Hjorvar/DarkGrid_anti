<%- include('partials/header') %>
<%
  const safeCombatState = (typeof combatState !== 'undefined' && combatState !== null) ? combatState : null;
  const safePotions = (typeof potions !== 'undefined' && Array.isArray(potions))
    ? potions
    : ((safeCombatState && Array.isArray(safeCombatState.potions)) ? safeCombatState.potions : []);
  const safePotionCount = (typeof potionCount !== 'undefined' && potionCount !== null)
    ? potionCount
    : safePotions.length;
  const safeEquipment = (typeof equipment !== 'undefined' && equipment !== null) ? equipment : {};
  const safeInventory = (typeof inventory !== 'undefined' && Array.isArray(inventory)) ? inventory : [];
  const safeHeroAC = (typeof heroAC !== 'undefined' && heroAC !== null) ? heroAC : 10;
  const safeMeleeAtk = (typeof meleeAttackBonus !== 'undefined' && meleeAttackBonus !== null) ? (meleeAttackBonus >= 0 ? '+' + meleeAttackBonus : '' + meleeAttackBonus) : '+0';
  const safeRangedAtk = (typeof rangedAttackBonus !== 'undefined' && rangedAttackBonus !== null) ? (rangedAttackBonus >= 0 ? '+' + rangedAttackBonus : '' + rangedAttackBonus) : '+0';
  const safeClericHealInfo = (typeof clericHealInfo !== 'undefined') ? clericHealInfo : null;
  const safeIsSafeCity = (typeof isSafeCity !== 'undefined') ? Boolean(isSafeCity) : (currentTile && currentTile.is_safe === 1 && currentTile.terrain === 'CITY');
  const safeShopStock = (typeof shopStock !== 'undefined') ? shopStock : null;
  const safeIsRangedActive = (typeof isRangedActive !== 'undefined') ? Boolean(isRangedActive) : false;
  const safeActiveWeapon = (typeof activeWeapon !== 'undefined') ? activeWeapon : null;
  const safeActiveModal = (typeof activeModal !== 'undefined' && ['character', 'backpack', 'market', 'journal', 'bounties'].includes(activeModal)) ? activeModal : null;
  const safeJournal = (typeof journalEncounters !== 'undefined' && Array.isArray(journalEncounters)) ? journalEncounters : [];
  const safeBountyContracts = (typeof bountyContracts !== 'undefined' && Array.isArray(bountyContracts)) ? bountyContracts : [];
  const safeWildernessThreats = (typeof wildernessThreats !== 'undefined' && Array.isArray(wildernessThreats)) ? wildernessThreats : [];
  const safeActiveContract = (typeof activeContract !== 'undefined' && activeContract !== null) ? activeContract : null;
  const safeClaimedBounties = (typeof claimedBounties !== 'undefined' && Array.isArray(claimedBounties)) ? claimedBounties : [];
  const safeBountyClaimMessage = (typeof bountyClaimMessage !== 'undefined' && bountyClaimMessage) ? bountyClaimMessage : null;
  const safeTerrainArtwork = (typeof terrainArtwork !== 'undefined' && terrainArtwork !== null)
    ? terrainArtwork
    : {
        imageUrl: '/images/terrain/terrain_fallback.webp',
        altText: 'Atmospheric dark fantasy wilderness vista.',
        title: 'Darkgrid Realm',
        description: '',
        isOverride: false,
        terrainType: (currentTile && currentTile.terrain) || 'UNKNOWN'
      };

  const isRevealed = Boolean(encounter && encounter.status === 'IN_COMBAT');
  const cleanMonsterName = isRevealed ? (encounter.monster_name || '').replace(/\[.*?\]/g, '').trim() : '';
  const cleanBaseMonsterName = isRevealed ? (encounter.base_monster_name || encounter.monster_name || '').replace(/\[.*?\]/g, '').trim() : '';
  const cleanSlug = isRevealed ? (encounter.imageSlug || cleanBaseMonsterName.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '')) : '';
  const monsterImgUrl = isRevealed ? (encounter.imageUrl || ('/images/monsters/' + cleanSlug + '.png')) : null;

  const isTwoHandedMeleeActive = !safeIsRangedActive && Boolean(safeEquipment.meleeWeapon && (Number(safeEquipment.meleeWeapon.is_two_handed) === 1 || safeEquipment.meleeWeapon.is_two_handed === true));
  const hpPercent = Math.min(100, Math.max(0, Math.round((character.current_hp / character.max_hp) * 100)));
  const backpackGear = safeInventory.filter(item => !item.equipped_slot && item.category !== 'POTION');
  const backpackItems = backpackGear;
  const isEquipLocked = Boolean(encounter && (encounter.status === 'IN_COMBAT' || encounter.status === 'DISCOVERED'));
%>

<div class="game-viewport dashboard-viewport">
  <div class="game-dashboard">
    <!-- ===================================================================
         LEFT COLUMN — World & Navigation
         =================================================================== -->
    <div class="dashboard-col col-left">
      <div class="dashboard-card world-nav-card">
        <div class="panel-header">
          <span class="panel-title">Minimap (5×5)</span>
          <span class="panel-coords">Coordinates: [X: <%= currentTile.x %>, Y: <%= currentTile.y %>]</span>
        </div>

        <!-- 5x5 Minimap Grid -->
        <div class="minimap-container">
          <div class="minimap-grid">
            <% minimap.rows.forEach(function(row) { %>
              <div class="minimap-row">
                <% row.forEach(function(cell) { %>
                  <div class="minimap-cell <%= cell.isPlayer ? 'is-player' : '' %> <%= cell.hasPersistentMonster ? 'has-persistent-monster' : '' %> <%= !cell.isPassable ? 'impassable' : '' %>"
                       style="color: <%= cell.color %>;"
                       title="<%= cell.label %> [<%= cell.x %>, <%= cell.y %>]">
                    <%= cell.symbol %>
                  </div>
                <% }); %>
              </div>
            <% }); %>
          </div>

          <div class="minimap-legend">
            <span><strong>@</strong> Hero</span>
            <span><strong>💀</strong> Fallen Threat</span>
            <span><strong>🏰</strong> City</span>
            <span><strong>🌲</strong> Forest</span>
            <span><strong>🌫️</strong> Swamp</span>
            <span><strong>🌴</strong> Jungle</span>
            <span><strong>🌾</strong> Plains</span>
          </div>
        </div>

        <!-- Movement Compass -->
        <div class="compass-section">
          <div class="compass-title-bar">Navigation (Movement)</div>
          <% if (encounter && encounter.status === 'DISCOVERED') { %>
            <div class="encounter-lock-banner">
              ⚠️ Path blocked: Investigate or bypass
            </div>
          <% } else if (encounter && encounter.status === 'IN_COMBAT') { %>
            <div class="encounter-lock-banner">
              ⚠️ Combat active: Fight or flee
            </div>
          <% } %>

          <div class="compass-rose-container">
            <div class="compass-grid">
              <!-- North -->
              <form action="/game/move" method="POST" class="compass-north">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <input type="hidden" name="direction" value="NORTH">
                <button type="submit" class="compass-btn" 
                  <%= (!directions.NORTH.available || encounter) ? 'disabled' : '' %>
                  title="<%= directions.NORTH.available ? directions.NORTH.tileName : directions.NORTH.reason %>">
                  <span class="compass-arrow">▲</span>
                  <span class="compass-dir-name">North</span>
                </button>
              </form>

              <!-- West -->
              <form action="/game/move" method="POST" class="compass-west">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <input type="hidden" name="direction" value="WEST">
                <button type="submit" class="compass-btn" 
                  <%= (!directions.WEST.available || encounter) ? 'disabled' : '' %>
                  title="<%= directions.WEST.available ? directions.WEST.tileName : directions.WEST.reason %>">
                  <span class="compass-arrow">◀</span>
                  <span class="compass-dir-name">West</span>
                </button>
              </form>

              <!-- Center marker -->
              <div class="compass-center" title="Current Location: <%= currentTile.name %>">
                <span class="compass-rose-glyph">✦</span>
              </div>

              <!-- East -->
              <form action="/game/move" method="POST" class="compass-east">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <input type="hidden" name="direction" value="EAST">
                <button type="submit" class="compass-btn" 
                  <%= (!directions.EAST.available || encounter) ? 'disabled' : '' %>
                  title="<%= directions.EAST.available ? directions.EAST.tileName : directions.EAST.reason %>">
                  <span class="compass-arrow">▶</span>
                  <span class="compass-dir-name">East</span>
                </button>
              </form>

              <!-- South -->
              <form action="/game/move" method="POST" class="compass-south">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <input type="hidden" name="direction" value="SOUTH">
                <button type="submit" class="compass-btn" 
                  <%= (!directions.SOUTH.available || encounter) ? 'disabled' : '' %>
                  title="<%= directions.SOUTH.available ? directions.SOUTH.tileName : directions.SOUTH.reason %>">
                  <span class="compass-arrow">▼</span>
                  <span class="compass-dir-name">South</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===================================================================
         CENTER COLUMN — Main Gameplay
         =================================================================== -->
    <div class="dashboard-col col-center">
      <div class="dashboard-card gameplay-card">
        <!-- Area Header Banner -->
        <div class="area-header-strip">
          <div class="area-name-group">
            <h1 class="area-title"><%= currentTile.name %></h1>
            <div class="area-badges">
              <span class="badge badge-terrain"><%= currentTile.terrain %></span>
              <% if (currentTile.is_safe === 1) { %>
                <span class="badge badge-safe">Safe Haven (Peaceful)</span>
              <% } else { %>
                <span class="badge badge-danger">Unexplored Wilderness</span>
              <% } %>
              <% if (currentTile.feature) { %>
                <span class="badge badge-feature"><%= currentTile.feature %></span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Feedback Alerts -->
        <% if (errorMessage) { %>
          <div class="alert alert-error" role="alert">
            <span class="alert-icon">⚠️</span>
            <span><%= errorMessage %></span>
          </div>
        <% } %>
        <% if (infoMessage) { %>
          <div class="alert alert-info" role="status">
            <span class="alert-icon">🕯️</span>
            <span><%= infoMessage %></span>
          </div>
        <% } %>
        <% if (safeBountyClaimMessage) { %>
          <div class="alert alert-bounty-claimed" role="status">
            <span class="alert-icon">🏆</span>
            <div><strong><%= safeBountyClaimMessage %></strong></div>
          </div>
        <% } %>
        <% if (safeClaimedBounties.length > 0) { %>
          <% safeClaimedBounties.forEach(function(claimed) { %>
            <div class="alert alert-bounty-claimed" role="status">
              <span class="alert-icon">🏆</span>
              <div>
                <strong>Bounty Completed!</strong> You have slain <strong><%= claimed.customName %></strong> (<%= claimed.baseMonsterName %> in <%= claimed.regionName %>). Oakhaven awards you <strong><%= claimed.rewardGold %> Gold</strong>.
              </div>
            </div>
          <% }); %>
        <% } %>
        <% if (safeInventory.length > 50) { %>
          <div class="alert alert-warning" role="alert" style="border-left: 4px solid #ef4444; background: rgba(239, 68, 68, 0.15); color: #fca5a5; padding: 10px 14px; margin-bottom: 12px; border-radius: 4px; display: flex; align-items: center; gap: 10px;">
            <span class="alert-icon" style="font-size: 1.2rem;">⚠️</span>
            <span><strong>Backpack Overflow (<%= safeInventory.length %>/50 items):</strong> You are carrying spoils beyond your backpack's standard capacity. Sell items in town to restore regular monster drops and shop purchases.</span>
          </div>
        <% } %>

        <!-- Environment Scene Vista -->
        <div class="terrain-vista-banner <%= (encounter && encounter.status === 'IN_COMBAT') ? 'in-combat' : ((encounter && encounter.status === 'DISCOVERED') ? 'in-discovered' : '') %>">
          <div class="terrain-vista-image-wrap">
            <img src="<%= safeTerrainArtwork.imageUrl %>" 
                 alt="<%= safeTerrainArtwork.altText %>" 
                 class="terrain-vista-image" 
                 loading="eager" />
            <div class="terrain-vista-gradient"></div>
            <% if (encounter && encounter.status === 'IN_COMBAT') { %>
              <div class="terrain-vista-combat-tint"></div>
            <% } else if (encounter && encounter.status === 'DISCOVERED') { %>
              <div class="terrain-vista-tension-tint"></div>
            <% } %>
          </div>
          <div class="terrain-vista-caption">
            <span class="terrain-vista-title"><%= safeTerrainArtwork.title %></span>
            <% if (safeTerrainArtwork.isOverride) { %>
              <span class="terrain-vista-badge">Landmark</span>
            <% } else { %>
              <span class="terrain-vista-badge"><%= currentTile.terrain %></span>
            <% } %>
          </div>
        </div>

        <!-- Dynamic Gameplay Content by State -->
        <div class="gameplay-content-area">
          <% if (encounter && encounter.status === 'IN_COMBAT') { %>
            <!-- -------------------------------------------------------------
                 STATE 1: ACTIVE COMBAT (Stage 2: Revealed Threat)
                 ------------------------------------------------------------- -->
            <div class="encounter-panel in-combat <%= encounter.isBountyTarget ? 'is-bounty-encounter' : '' %>">
              <div class="encounter-header">
                <div class="encounter-title">
                  <span class="encounter-symbol-badge" style="color: <%= encounter.monster_color || 'var(--accent-crimson)' %>;">
                    [<%= encounter.monster_symbol %>]
                  </span>
                  <span>Revealed Threat: <strong><%= cleanMonsterName %></strong></span>
                  <% if (encounter.isBountyTarget && cleanBaseMonsterName && cleanBaseMonsterName !== cleanMonsterName) { %>
                    <span class="bounty-species-sublabel">(<%= cleanBaseMonsterName %>)</span>
                  <% } %>
                </div>
                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                  <% if (encounter.isBountyTarget) { %>
                    <span class="bounty-target-badge">🎯 Wanted Quarry</span>
                  <% } else if (encounter.custom_title) { %>
                    <span class="bounty-target-badge">💀 Infamous Killer</span>
                  <% } %>
                  <% if (encounter.isRangerSpecial) { %>
                    <span class="ranger-badge">🏹 Ranger at close quarters</span>
                  <% } %>
                </div>
              </div>

              <% if (encounter.isBountyTarget && encounter.bountyTraitNotice) { %>
                <div class="bounty-combat-banner">
                  <span class="bounty-banner-tag">🎯 Watcher's Warrant</span>
                  <span class="bounty-banner-detail"><%= encounter.bountyTraitNotice %></span>
                </div>
              <% } %>

              <div class="combat-middle-layout">
                <!-- Monster Artwork -->
                <div class="monster-art-container">
                  <div class="monster-art-frame <%= (encounter.isBountyTarget || encounter.custom_title) ? 'bounty-art-frame' : '' %>">
                    <% if (monsterImgUrl) { %>
                      <img src="<%= monsterImgUrl %>" alt="<%= cleanMonsterName %>" class="monster-art-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                      <div class="monster-placeholder" style="display: none;">
                        <div class="placeholder-rune">ᚱ</div>
                        <div class="placeholder-symbol" style="color: <%= encounter.monster_color || 'var(--accent-gold)' %>;">
                          <%= encounter.monster_symbol %>
                        </div>
                        <div class="placeholder-label"><%= cleanMonsterName %></div>
                        <div class="placeholder-sublabel"><%= encounter.isBountyTarget ? 'Wanted Quarry' : 'Revealed Threat' %></div>
                      </div>
                    <% } else { %>
                      <div class="monster-placeholder">
                        <div class="placeholder-rune">ᚱ</div>
                        <div class="placeholder-symbol" style="color: <%= encounter.monster_color || 'var(--accent-gold)' %>;">
                          <%= encounter.monster_symbol %>
                        </div>
                        <div class="placeholder-label"><%= cleanMonsterName %></div>
                        <div class="placeholder-sublabel"><%= encounter.isBountyTarget ? 'Wanted Quarry' : 'Revealed Threat' %></div>
                      </div>
                    <% } %>
                    <div class="monster-art-vignette"></div>
                  </div>
                </div>

                <!-- Monster Condition & Combat Log -->
                <div class="combat-intel-column">
                  <% if (safeCombatState && safeCombatState.currentConditionText) { %>
                    <div class="monster-condition-box">
                      “<%= safeCombatState.currentConditionText %>”
                    </div>
                  <% } %>

                  <% if (safeCombatState && Array.isArray(safeCombatState.heroStatusBadges) && safeCombatState.heroStatusBadges.length > 0) { %>
                    <div class="hero-combat-statuses" style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px;">
                      <% safeCombatState.heroStatusBadges.forEach(function(badge) { %>
                        <span class="combat-status-badge status-<%= badge.severity || 'warning' %>" style="font-size: 0.78rem; padding: 3px 8px; border-radius: 4px; background: <%= badge.severity === 'danger' ? 'rgba(220, 38, 38, 0.25)' : (badge.severity === 'warning' ? 'rgba(217, 119, 6, 0.22)' : 'rgba(59, 130, 246, 0.2)') %>; border: 1px solid <%= badge.severity === 'danger' ? '#ef4444' : (badge.severity === 'warning' ? '#f59e0b' : '#60a5fa') %>; color: <%= badge.severity === 'danger' ? '#fca5a5' : (badge.severity === 'warning' ? '#fde68a' : '#bfdbfe') %>; font-weight: 600;">
                          ⚠️ <%= badge.label %>
                        </span>
                      <% }); %>
                    </div>
                  <% } %>

                  <div class="combat-log-container">
                    <%
                      // Filter out CONDITION events to prevent repeating the condition quote directly below itself
                      const actionEvents = (safeCombatState && safeCombatState.events)
                        ? safeCombatState.events.filter(ev => ev.event_type !== 'CONDITION')
                        : [];
                      const latestRoundNum = actionEvents.length > 0
                        ? Math.max(...actionEvents.map(ev => Number(ev.round_number || 1)))
                        : (encounter.combat_round || 1);
                      const currentRoundEvents = actionEvents.filter(ev => Number(ev.round_number || 1) === latestRoundNum);
                    %>
                    <div class="combat-log-header">
                      Battle Record (Round <%= encounter.combat_round || 1 %>)
                    </div>
                    <div class="combat-log-scroll">
                      <% if (currentRoundEvents.length > 0) { %>
                        <% currentRoundEvents.forEach(function(ev) { %>
                          <div class="combat-event-row <%= (ev.event_type || '').toLowerCase() %>">
                            <% if (ev.event_type === 'OPENING_SHOT') { %>🏹 <% } %>
                            <% if (ev.event_type === 'HERO_ATTACK') { %>⚔️ <% } %>
                            <% if (ev.event_type === 'MONSTER_ATTACK') { %>🩸 <% } %>
                            <% if (ev.event_type === 'MONSTER_ABILITY') { %>⚡ <% } %>
                            <% if (ev.event_type === 'STATUS_EFFECT') { %>☠️ <% } %>
                            <% if (ev.event_type === 'POTION_USED') { %>🧪 <% } %>
                            <% if (ev.event_type === 'FLEE') { %>🏃 <% } %>
                            <% if (ev.event_type === 'MONSTER_CONDITION') { %>⚠️ <% } %>
                            <span><%= ev.public_text %></span>
                          </div>
                        <% }); %>
                      <% } else { %>
                        <div class="combat-event-row empty-log">Battle joined. Select your combat action below.</div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Bar (Never requires scrolling) -->
              <div class="combat-actions-bar">
                <!-- Attack -->
                <form action="/game/combat/attack" method="POST" class="combat-action-form form-attack">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                  <input type="hidden" name="round" value="<%= encounter.combat_round || 1 %>">
                  <button type="submit" class="btn btn-attack">
                    ⚔️ Attack
                  </button>
                </form>

                <!-- Drink Potion -->
                <form action="/game/combat/potion" method="POST" class="combat-action-form form-potion">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                  <input type="hidden" name="round" value="<%= encounter.combat_round || 1 %>">
                  <% if (safePotions && safePotions.length > 0) { %>
                    <div class="potion-input-group">
                      <select name="potionInstanceId" class="form-control potion-select" aria-label="Select healing potion">
                        <% safePotions.forEach((p, idx) => { %>
                          <option value="<%= p.id %>" <%= idx === 0 ? 'selected' : '' %>>
                            <%= p.displayName || p.name %>
                          </option>
                        <% }); %>
                      </select>
                      <button type="submit" class="btn btn-secondary potion-btn">
                        🧪 Drink Potion (<%= safePotionCount %>)
                      </button>
                    </div>
                  <% } else { %>
                    <div class="potion-input-group">
                      <select disabled class="form-control potion-select" aria-label="No potions available">
                        <option>No Potions Available</option>
                      </select>
                      <button type="submit" class="btn btn-secondary potion-btn" disabled>
                        🧪 Drink Potion (0)
                      </button>
                    </div>
                  <% } %>
                </form>

                <!-- Flee -->
                <form action="/game/combat/flee" method="POST" class="combat-action-form form-flee" onsubmit="return confirm('Fleeing triggers a free Attack of Opportunity from the monster. Are you certain you wish to flee?');">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                  <input type="hidden" name="round" value="<%= encounter.combat_round || 1 %>">
                  <button type="submit" class="btn btn-secondary flee-btn">
                    🏃 Flee
                  </button>
                </form>
              </div>
            </div>

          <% } else if (encounter && encounter.status === 'DISCOVERED') { %>
            <!-- -------------------------------------------------------------
                 STATE 2: DISCOVERED ENCOUNTER (Stage 1: Unknown Threat)
                 ------------------------------------------------------------- -->
            <div class="encounter-panel is-hidden-threat">
              <div class="encounter-header">
                <div class="encounter-title">
                  <span class="encounter-symbol-badge mystery-badge">[?]</span>
                  <span>Unknown Threat: <em>Obscure shape in the shadows</em></span>
                </div>
                <% if (encounter.isRangerSpecial) { %>
                  <span class="ranger-badge">🏹 Ranger perceives a clue</span>
                <% } %>
              </div>

              <div class="encounter-content-layout">
                <div class="monster-art-container">
                  <div class="monster-art-frame mystery-art-frame">
                    <div class="mystery-placeholder">
                      <div class="mystery-fog-overlay"></div>
                      <div class="placeholder-rune mystery-rune">ᚦ</div>
                      <div class="mystery-symbol">?</div>
                      <div class="placeholder-label">Unknown Threat</div>
                      <div class="placeholder-sublabel">Shadows and rustling in the dark</div>
                    </div>
                    <div class="monster-art-vignette"></div>
                  </div>
                </div>

                <div class="encounter-details-column">
                  <% if (encounter.isAmbush) { %>
                    <div class="ambush-banner">
                      ⚠️ <strong>Ambush!</strong> The creature lunged from hiding before you could spot it—your retreat is cut off and the enemy seizes surprise advantage!
                    </div>
                  <% } %>

                  <p class="encounter-text">
                    <%= encounter.resolvedDescription %>
                  </p>

                  <div class="encounter-actions-bar">
                    <form action="/game/encounter/investigate" method="POST">
                      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                      <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                      <button type="submit" class="btn btn-primary">
                        <% if (encounter.isAmbush) { %>⚔️ Face the Ambush<% } else { %>Advance & Investigate<% } %>
                      </button>
                    </form>

                    <% if (encounter.isAmbush) { %>
                      <button type="button" class="btn btn-secondary" disabled title="You have been ambushed and cannot slip past undetected!">
                        🚫 Retreat Cut Off (Ambushed)
                      </button>
                    <% } else { %>
                      <form action="/game/encounter/ignore" method="POST">
                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                        <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                        <button type="submit" class="btn btn-secondary">
                          Bypass & Ignore
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>

          <% } else if (safeIsSafeCity) { %>
            <!-- -------------------------------------------------------------
                 STATE 3: CITY (Safe Haven)
                 ------------------------------------------------------------- -->
            <div class="peaceful-panel city-panel">
              <div class="tile-narrative">
                <div class="narrative-quote-icon">“</div>
                <div class="narrative-body"><%= currentTile.description %></div>
              </div>

              <div class="peaceful-status-card city-card">
                <div class="peaceful-card-title">🛡️ Safe Haven Sanctuary</div>
                <p class="peaceful-card-text">
                  The gates of <%= currentTile.name %> stand shut against the horrors of the wild. You may rest safely in the sanctuary, inspect The Watcher's Board for hunting contracts, or trade equipment with the town merchants.
                </p>
              </div>

              <div class="peaceful-actions-grid">
                <form action="/game/rest" method="POST" style="flex: 1; min-width: 200px;">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <button type="submit" class="btn btn-primary" style="width: 100%;">
                    🛌 Rest at Sanctuary (Full Heal & Ability Recharge)
                  </button>
                </form>

                <button type="button" class="btn btn-secondary btn-watchers-board" onclick="openGameModal('bounties')" id="btn-open-watchers-board" style="flex: 1; min-width: 190px; border-color: var(--accent-gold); color: var(--accent-gold);">
                  🎯 The Watcher's Board
                </button>

                <% if (safeShopStock) { %>
                  <button type="button" class="btn btn-secondary" onclick="openGameModal('market')" style="flex: 1; min-width: 180px;">
                    🛒 Town Market & Supplies
                  </button>
                <% } %>

                <% if (safeClericHealInfo) { %>
                  <form action="/game/cleric/heal" method="POST" style="flex: 1; min-width: 180px;">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <button type="submit" class="btn btn-secondary" style="width: 100%; border-color: var(--accent-gold);" <%= (safeClericHealInfo.remainingUses <= 0 || character.current_hp >= character.max_hp) ? 'disabled' : '' %>>
                      ✨ Channel Divine Healing (<%= safeClericHealInfo.remainingUses %>/<%= safeClericHealInfo.maxUses %> uses)
                    </button>
                  </form>
                <% } %>
              </div>
            </div>

          <% } else if (currentTile.is_safe === 1) { %>
            <!-- -------------------------------------------------------------
                 STATE 3b: SAFE HAVEN PERIMETER / TOWN GATES
                 ------------------------------------------------------------- -->
            <div class="peaceful-panel gate-panel">
              <div class="tile-narrative">
                <div class="narrative-quote-icon">“</div>
                <div class="narrative-body"><%= currentTile.description %></div>
              </div>

              <div class="peaceful-status-card gate-card">
                <div class="peaceful-card-title">🛡️ Guarded Town Perimeter</div>
                <p class="peaceful-card-text">
                  You stand within the fortified perimeter of <%= currentTile.name %>. Watchmen patrol the palisades, keeping predatory beasts at bay. Travel into the city to trade and rest, or venture beyond the gates to explore the wild realm.
                </p>
              </div>

              <% if (safeClericHealInfo) { %>
                <div class="peaceful-actions-grid" style="margin-top: 10px;">
                  <form action="/game/cleric/heal" method="POST" style="flex: 1;">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <button type="submit" class="btn btn-secondary" style="width: 100%; border-color: var(--accent-gold);" <%= (safeClericHealInfo.remainingUses <= 0 || character.current_hp >= character.max_hp) ? 'disabled' : '' %>>
                      ✨ Channel Divine Healing (<%= safeClericHealInfo.remainingUses %>/<%= safeClericHealInfo.maxUses %> uses • <%= safeClericHealInfo.diceCount %>d6+WIS)
                    </button>
                  </form>
                </div>
              <% } %>
            </div>

          <% } else { %>
            <!-- -------------------------------------------------------------
                 STATE 4: EXPLORATION (Wilderness Peaceful)
                 ------------------------------------------------------------- -->
            <div class="peaceful-panel wilderness-panel">
              <div class="tile-narrative">
                <div class="narrative-quote-icon">“</div>
                <div class="narrative-body"><%= currentTile.description %></div>
              </div>

              <div class="peaceful-status-card wilderness-card">
                <div class="peaceful-card-title">🌲 Unexplored Wilderness</div>
                <p class="peaceful-card-text">
                  The surrounding land lies quiet for now. Mist creeps through the undergrowth, yet no immediate threats have provoked battle. Choose a cardinal direction on the navigation compass to explore further into the realm.
                </p>
              </div>

              <% if (safeClericHealInfo) { %>
                <div class="peaceful-actions-grid" style="margin-top: 10px;">
                  <form action="/game/cleric/heal" method="POST" style="flex: 1;">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <button type="submit" class="btn btn-secondary" style="width: 100%; border-color: var(--accent-gold);" <%= (safeClericHealInfo.remainingUses <= 0 || character.current_hp >= character.max_hp) ? 'disabled' : '' %>>
                      ✨ Channel Divine Healing (<%= safeClericHealInfo.remainingUses %>/<%= safeClericHealInfo.maxUses %> uses • <%= safeClericHealInfo.diceCount %>d6+WIS)
                    </button>
                  </form>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ===================================================================
         RIGHT COLUMN — Compact Hero Panel
         =================================================================== -->
    <div class="dashboard-col col-right">
      <div class="dashboard-card hero-panel">
        <div class="panel-header hero-header">
          <div>
            <div class="char-hero-name"><%= character.name %></div>
            <div class="char-hero-class"><%= character.class %> • Level <%= character.level %></div>
          </div>
        </div>

        <div class="hero-vitals-section">
          <!-- HP Gauge Bar -->
          <div class="vital-box hp-box">
            <div class="vital-header-row">
              <div class="vital-label">Vitality (HP)</div>
              <div class="vital-value hp"><%= character.current_hp %> / <%= character.max_hp %></div>
            </div>
            <div class="vital-gauge-track" title="HP: <%= hpPercent %>%">
              <div class="vital-gauge-bar hp-fill <%= hpPercent <= 25 ? 'critical' : (hpPercent <= 50 ? 'wounded' : 'healthy') %>" style="width: <%= hpPercent %>%;"></div>
            </div>
          </div>

          <!-- 2x2 Stats Grid -->
          <div class="vitals-grid">
            <!-- Armor Class -->
            <div class="vital-box">
              <div class="vital-header-row">
                <div class="vital-label">Armor Class (AC)</div>
                <div class="vital-value" style="color: var(--accent-gold);"><%= safeHeroAC %></div>
              </div>
              <div class="vital-gold-decor">⚔️ <%= safeMeleeAtk %> • 🏹 <%= safeRangedAtk %></div>
            </div>

            <!-- Gold -->
            <div class="vital-box">
              <div class="vital-header-row">
                <div class="vital-label">Gold</div>
                <div class="vital-value gold"><%= character.gold %> <span class="gold-unit">gp</span></div>
              </div>
              <div class="vital-gold-decor">✦ In purse</div>
            </div>

            <!-- Healing Potions -->
            <div class="vital-box">
              <div class="vital-header-row">
                <div class="vital-label">Healing Potions</div>
                <div class="vital-value" style="color: #7ce;"><%= safePotionCount %></div>
              </div>
              <div class="vital-gold-decor">🧪 In pack</div>
            </div>

            <!-- Progression (XP) -->
            <div class="vital-box">
              <div class="vital-header-row">
                <div class="vital-label">Experience</div>
                <div class="vital-value" style="color: var(--text-heading);"><%= character.xp %> <span class="gold-unit">xp</span></div>
              </div>
              <div class="vital-gold-decor"><span class="status-alive-badge">● Alive</span></div>
            </div>
          </div>
        </div>

        <!-- Navigation Action Buttons (Modals) — Placed immediately below vitals for high accessibility -->
        <div class="dashboard-menu-grid">
          <button type="button" class="dashboard-menu-btn" onclick="openGameModal('character')" id="btn-open-character" aria-haspopup="dialog">
            <span class="menu-btn-icon">👤</span>
            <span class="menu-btn-label">Character</span>
          </button>
          <button type="button" class="dashboard-menu-btn <%= safeInventory.length > 50 ? 'is-warning' : '' %>" onclick="openGameModal('backpack')" id="btn-open-backpack" aria-haspopup="dialog" style="<%= safeInventory.length > 50 ? 'border-color: #ef4444; color: #fca5a5;' : '' %>">
            <span class="menu-btn-icon">🎒</span>
            <span class="menu-btn-label">Backpack (<%= safeInventory.length %>/50)<%= safeInventory.length > 50 ? ' ⚠️' : '' %></span>
          </button>
          <button type="button" class="dashboard-menu-btn <%= !safeIsSafeCity ? 'is-disabled' : '' %>" onclick="openGameModal('market')" id="btn-open-market" aria-haspopup="dialog" title="<%= safeIsSafeCity ? 'Open Town Market' : 'Available in Safe Haven cities' %>">
            <span class="menu-btn-icon">🛒</span>
            <span class="menu-btn-label">Market</span>
          </button>
          <button type="button" class="dashboard-menu-btn" onclick="openGameModal('journal')" id="btn-open-journal" aria-haspopup="dialog">
            <span class="menu-btn-icon">📜</span>
            <span class="menu-btn-label">Journal</span>
          </button>
        </div>

        <!-- Active Weapon & Prepared Gear -->
        <div class="prepared-gear-card">
          <div class="gear-card-header">
            <span class="gear-header-lbl">Prepared Gear</span>
            <span class="gear-active-stance">Active: <%= safeIsRangedActive ? '🏹 Ranged' : '🗡️ Melee' %></span>
          </div>
          <div class="gear-summary-lines">
            <div>🗡️ <strong>Melee:</strong> <%= (safeEquipment.meleeWeapon ? safeEquipment.meleeWeapon.name : (safeEquipment.weapon ? safeEquipment.weapon.name : 'Bare Hands')) %></div>
            <div>🏹 <strong>Ranged:</strong> <%= (safeEquipment.rangedWeapon ? safeEquipment.rangedWeapon.name : 'None') %></div>
            <div>
              🛡️ <strong>Protection:</strong> <%= (safeEquipment.armor ? safeEquipment.armor.name : 'Unarmored') %> <%= safeEquipment.shield ? ('+ ' + safeEquipment.shield.name) : '' %>
              <% if (safeIsRangedActive && safeEquipment.shield) { %>
                <span style="color: var(--text-dim); font-size: 0.75rem;">(Shield disabled with ranged)</span>
              <% } else if (isTwoHandedMeleeActive && safeEquipment.shield) { %>
                <span style="color: var(--text-dim); font-size: 0.75rem;">(Shield disabled with two-handed weapon)</span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Active Hunting Contract Summary -->
        <%
          const isStage1Secrecy = Boolean(encounter && encounter.status === 'DISCOVERED');
        %>
        <% if (safeActiveContract) { %>
          <div class="prepared-gear-card active-contract-card <%= safeActiveContract.status === 'READY_TO_CLAIM' ? 'is-ready-claim' : '' %>" id="active-contract-panel">
            <div class="gear-card-header">
              <span class="gear-header-lbl">🎯 Active Warrant</span>
              <span class="contract-status-pill <%= safeActiveContract.status === 'READY_TO_CLAIM' ? 'status-claim' : 'status-hunting' %>">
                <%= safeActiveContract.status === 'READY_TO_CLAIM' ? 'Target Slain' : 'Active Hunt' %>
              </span>
            </div>
            <div class="gear-summary-lines">
              <div class="contract-card-title"><strong><%= safeActiveContract.contract_title %></strong></div>
              <% if (safeActiveContract.status === 'READY_TO_CLAIM') { %>
                <div style="color: #68d391;">✔ Quarry Slain: <strong><%= isStage1Secrecy ? 'Hunted Quarry' : safeActiveContract.custom_name %></strong></div>
                <div style="color: var(--accent-gold);">🏛️ Return alive to Oakhaven to claim <strong><%= safeActiveContract.reward_gold %> gp</strong></div>
              <% } else { %>
                <div>🐾 <strong>Target:</strong> <%= isStage1Secrecy ? 'Dangerous Quarry' : ('Dangerous ' + safeActiveContract.base_monster_name) %></div>
                <div>🧭 <strong>Region:</strong> <%= safeActiveContract.target_region %><%= safeActiveContract.compass_direction && safeActiveContract.compass_direction !== 'In Oakhaven' ? (' (' + safeActiveContract.compass_direction + ' of Oakhaven)') : '' %></div>
                <div>🪙 <strong>Bounty:</strong> <span style="color: var(--accent-gold); font-weight: 700;"><%= safeActiveContract.reward_gold %> gp</span></div>
              <% } %>
            </div>
            <% if (safeActiveContract.status === 'ACTIVE') { %>
              <div style="margin-top: 8px; display: flex; justify-content: flex-end;">
                <form action="/game/bounties/abandon" method="POST" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <input type="hidden" name="contractId" value="<%= safeActiveContract.id %>">
                  <button type="submit" class="btn btn-subtle" style="padding: 3px 8px; font-size: 0.72rem;">Abandon Contract</button>
                </form>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- =====================================================================
     MODAL / DRAWER SYSTEM
     ===================================================================== -->
<div class="game-modal-backdrop <%= safeActiveModal ? 'is-active' : '' %>" id="game-modal-backdrop" <%= safeActiveModal ? '' : 'hidden' %> onclick="handleBackdropClick(event)">
  <!-- -------------------------------------------------------------------
       1. CHARACTER MODAL
       ------------------------------------------------------------------- -->
  <div class="game-modal-dialog" id="modal-character" role="dialog" aria-modal="true" aria-labelledby="modal-character-title" <%= safeActiveModal === 'character' ? '' : 'hidden' %>>
    <div class="game-modal-header">
      <h2 class="game-modal-title" id="modal-character-title">👤 Hero Record — <%= character.name %></h2>
      <button type="button" class="game-modal-close" onclick="closeGameModal()" aria-label="Close dialog">✕</button>
    </div>
    <div class="game-modal-body">
      <div class="modal-section-group">
        <h3 class="modal-subheading">Attributes & d20 Modifiers</h3>
        <table class="stats-table">
          <thead>
            <tr>
              <th class="stat-th-lbl">Attribute</th>
              <th class="stat-th-num">Score</th>
              <th class="stat-th-mod">d20 Mod</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="stat-lbl">STR (Strength) <span style="font-size: 0.72rem; color: var(--text-dim); display: block;">Melee attack & damage</span></td>
              <td class="stat-num">
                <%= character.strength %>
                <% if (character.is_str_boosted) { %>
                  <span style="color: var(--accent-gold); font-size: 0.75rem; font-weight: normal;">(+2 Belt)</span>
                <% } %>
              </td>
              <td class="stat-mod <%= modifiers.strength.startsWith('+') && modifiers.strength !== '+0' ? 'positive' : (modifiers.strength.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.strength %></td>
            </tr>
            <tr>
              <td class="stat-lbl">CON (Constitution) <span style="font-size: 0.72rem; color: var(--text-dim); display: block;">Vitality (HP) & Fortitude</span></td>
              <td class="stat-num"><%= character.constitution %></td>
              <td class="stat-mod <%= modifiers.constitution.startsWith('+') && modifiers.constitution !== '+0' ? 'positive' : (modifiers.constitution.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.constitution %></td>
            </tr>
            <tr>
              <td class="stat-lbl">DEX (Dexterity) <span style="font-size: 0.72rem; color: var(--text-dim); display: block;">Ranged attack, AC, Initiative & Reflex</span></td>
              <td class="stat-num"><%= character.dexterity %></td>
              <td class="stat-mod <%= modifiers.dexterity.startsWith('+') && modifiers.dexterity !== '+0' ? 'positive' : (modifiers.dexterity.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.dexterity %></td>
            </tr>
            <tr>
              <td class="stat-lbl">INT (Intelligence) <span style="font-size: 0.72rem; color: var(--text-dim); display: block;">Experience gained (±10% XP per mod)</span></td>
              <td class="stat-num"><%= character.intelligence %></td>
              <td class="stat-mod <%= modifiers.intelligence.startsWith('+') && modifiers.intelligence !== '+0' ? 'positive' : (modifiers.intelligence.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.intelligence %></td>
            </tr>
            <tr>
              <td class="stat-lbl">WIS (Wisdom) <span style="font-size: 0.72rem; color: var(--text-dim); display: block;">Perception, Cleric healing & Will</span></td>
              <td class="stat-num"><%= character.wisdom %></td>
              <td class="stat-mod <%= modifiers.wisdom.startsWith('+') && modifiers.wisdom !== '+0' ? 'positive' : (modifiers.wisdom.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.wisdom %></td>
            </tr>
            <tr>
              <td class="stat-lbl">CHA (Charisma) <span style="font-size: 0.72rem; color: var(--text-dim); display: block;">Merchant prices (±5% shop price per mod)</span></td>
              <td class="stat-num"><%= character.charisma %></td>
              <td class="stat-mod <%= modifiers.charisma.startsWith('+') && modifiers.charisma !== '+0' ? 'positive' : (modifiers.charisma.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.charisma %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="modal-section-group">
        <h3 class="modal-subheading">Class Abilities & Specializations</h3>
        <% if (character.class === 'FIGHTER') { %>
          <div class="ability-card">
            <div class="ability-title">⚔️ Fighter Disciplines</div>
            <div class="ability-tier-row">
              <span class="ability-badge-active">Active</span>
              <div>
                <strong>Martial Weapon Training:</strong> Mastery of all arms. Base combat progression (+<%= Math.max(0, character.level - 1) %> Attack).
              </div>
            </div>
            <div class="ability-tier-row">
              <span class="ability-badge-active">Active</span>
              <div>
                <strong>Armor Proficiency:</strong> Trained in heavy plate and shields, sustaining defensive maneuverability.
              </div>
            </div>
            <div class="ability-tier-row <%= character.level >= 3 ? '' : 'is-locked' %>">
              <span class="<%= character.level >= 3 ? 'ability-badge-active' : 'ability-badge-locked' %>">
                <%= character.level >= 3 ? 'Active' : 'Unlocks Lvl 3' %>
              </span>
              <div>
                <strong>Armor Training I:</strong> +1 Maximum Dexterity bonus allowed by armor.
              </div>
            </div>
            <div class="ability-tier-row <%= character.level >= 5 ? '' : 'is-locked' %>">
              <span class="<%= character.level >= 5 ? 'ability-badge-active' : 'ability-badge-locked' %>">
                <%= character.level >= 5 ? 'Active' : 'Unlocks Lvl 5' %>
              </span>
              <div>
                <strong>Weapon Training I:</strong> +1 bonus to all attack and damage rolls with weaponry.
              </div>
            </div>
            <div class="ability-tier-row <%= character.level >= 7 ? '' : 'is-locked' %>">
              <span class="<%= character.level >= 7 ? 'ability-badge-active' : 'ability-badge-locked' %>">
                <%= character.level >= 7 ? 'Active' : 'Unlocks Lvl 7' %>
              </span>
              <div>
                <strong>Armor Training II:</strong> +2 Maximum Dexterity bonus allowed by armor.
              </div>
            </div>
          </div>
        <% } else if (character.class === 'RANGER') { %>
          <div class="ability-card">
            <div class="ability-title">🏹 Ranger Survival & Stalking</div>
            <div class="ability-tier-row">
              <span class="ability-badge-active">Active</span>
              <div>
                <strong>Favored Enemy:</strong> Specialized combat tactics against <strong><%= character.favored_enemy_type %><%= character.favored_enemy_subtype ? (' (' + character.favored_enemy_subtype + ')') : '' %></strong> (+1 Attack & Damage).
              </div>
            </div>
            <div class="ability-tier-row">
              <span class="ability-badge-active">Active</span>
              <div>
                <strong>Keen Senses & Opening Shot:</strong> Detects obscure wilderness clues and fires a free Opening Shot against spotted ground threats before combat begins.
              </div>
            </div>
            <div class="ability-tier-row <%= character.level >= 5 ? '' : 'is-locked' %>">
              <span class="<%= character.level >= 5 ? 'ability-badge-active' : 'ability-badge-locked' %>">
                <%= character.level >= 5 ? 'Active' : 'Unlocks Lvl 5' %>
              </span>
              <div>
                <strong>Favored Enemy II:</strong> Bonus increases to +2 Attack and Damage.
              </div>
            </div>
            <div class="ability-tier-row <%= character.level >= 9 ? '' : 'is-locked' %>">
              <span class="<%= character.level >= 9 ? 'ability-badge-active' : 'ability-badge-locked' %>">
                <%= character.level >= 9 ? 'Active' : 'Unlocks Lvl 9' %>
              </span>
              <div>
                <strong>Favored Enemy III:</strong> Bonus increases to +3 Attack and Damage.
              </div>
            </div>
          </div>
        <% } else if (character.class === 'CLERIC') { %>
          <div class="ability-card">
            <div class="ability-title">✨ Divine Favor & Radiance</div>
            <div class="ability-tier-row">
              <span class="ability-badge-active">Active</span>
              <div>
                <strong>Holy Radiance:</strong> Sacred light punishes Undead abominations (+2 Atk, +3 Dmg, +2 AC bonus).
              </div>
            </div>
            <div class="ability-tier-row">
              <span class="ability-badge-active">Active</span>
              <div>
                <strong>Channel Divine Energy:</strong> Out-of-combat meditative healing (<%= safeClericHealInfo ? safeClericHealInfo.dice : '1d6' %>, <%= safeClericHealInfo ? safeClericHealInfo.remainingUses : 0 %>/<%= safeClericHealInfo ? safeClericHealInfo.maxUses : 3 %> uses remaining).
              </div>
            </div>
            <div class="ability-tier-row <%= character.level >= 3 ? '' : 'is-locked' %>">
              <span class="<%= character.level >= 3 ? 'ability-badge-active' : 'ability-badge-locked' %>">
                <%= character.level >= 3 ? 'Active' : 'Unlocks Lvl 3' %>
              </span>
              <div>
                <strong>Channel Energy II:</strong> Self-healing increases to 2d6 per use.
              </div>
            </div>
            <div class="ability-tier-row <%= character.level >= 5 ? '' : 'is-locked' %>">
              <span class="<%= character.level >= 5 ? 'ability-badge-active' : 'ability-badge-locked' %>">
                <%= character.level >= 5 ? 'Active' : 'Unlocks Lvl 5' %>
              </span>
              <div>
                <strong>Holy Radiance II & Healing III:</strong> Self-healing reaches 3d6; Holy Radiance empowers to +3 Atk, +4 Dmg, +3 AC.
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <div class="modal-section-group">
        <h3 class="modal-subheading">Primary Weapon Preference</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">
          Select your default combat stance. Melee uses Strength and keeps your shield raised (with a slight reach penalty against flying foes); Ranged uses Dexterity and strikes flying foes without penalty.
        </p>
        <div style="display: flex; gap: 10px;">
          <form action="/game/character/primary-weapon" method="POST" style="flex: 1;">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <input type="hidden" name="primaryWeapon" value="MELEE">
            <input type="hidden" name="returnModal" value="character">
            <button type="submit" class="btn <%= (character.primary_weapon || 'MELEE') === 'MELEE' ? 'btn-primary' : 'btn-secondary' %>" style="width: 100%;" <% if (isEquipLocked) { %>disabled title="Cannot switch during combat or unresolved encounter"<% } %>>
              🗡️ Melee <%= (character.primary_weapon || 'MELEE') === 'MELEE' ? '✓' : '' %>
            </button>
          </form>
          <form action="/game/character/primary-weapon" method="POST" style="flex: 1;">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <input type="hidden" name="primaryWeapon" value="RANGED">
            <input type="hidden" name="returnModal" value="character">
            <button type="submit" class="btn <%= character.primary_weapon === 'RANGED' ? 'btn-primary' : 'btn-secondary' %>" style="width: 100%;" <% if (isEquipLocked) { %>disabled title="Cannot switch during combat or unresolved encounter"<% } %>>
              🏹 Ranged <%= character.primary_weapon === 'RANGED' ? '✓' : '' %>
            </button>
          </form>
        </div>
        <% if (isEquipLocked) { %>
          <div style="font-size: 0.75rem; color: #fca5a5; margin-top: 6px; text-align: center;">Weapon preference is locked during active combat or an unresolved encounter.</div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- -------------------------------------------------------------------
       2. BACKPACK MODAL
       ------------------------------------------------------------------- -->
  <div class="game-modal-dialog" id="modal-backpack" role="dialog" aria-modal="true" aria-labelledby="modal-backpack-title" <%= safeActiveModal === 'backpack' ? '' : 'hidden' %>>
    <div class="game-modal-header">
      <h2 class="game-modal-title" id="modal-backpack-title">🎒 Equipment & Backpack (<%= character.name %>)</h2>
      <button type="button" class="game-modal-close" onclick="closeGameModal()" aria-label="Close dialog">✕</button>
    </div>
    <div class="game-modal-body">
      <% if (safeInventory.length > 50) { %>
        <div class="modal-notice-box" style="border: 1px solid #ef4444; background: rgba(239, 68, 68, 0.15); color: #fca5a5; margin-bottom: 16px;">
          <div class="notice-title" style="color: #ef4444;">⚠️ BACKPACK OVERFLOW (<%= safeInventory.length %>/50 items)</div>
          <p>Your pack holds spoils from a defeated champion's slayer that exceeded standard capacity. All items have been safely preserved. However, you cannot receive new regular monster drops or purchase items in town until your inventory is reduced to 50 or fewer items.</p>
        </div>
      <% } %>
      <!-- Equipped Gear -->
      <div class="modal-section-group">
        <h3 class="modal-subheading">Equipped Armaments & Protection</h3>
        <% if (isEquipLocked) { %>
          <div class="modal-combat-lock-note">
            ⚠️ Armaments cannot be equipped or unequipped during active combat or an unresolved encounter.
          </div>
        <% } %>
        <% const equippedItems = [
          safeEquipment.meleeWeapon,
          safeEquipment.rangedWeapon,
          safeEquipment.armor,
          safeEquipment.shield,
          safeEquipment.ring,
          safeEquipment.cloak,
          safeEquipment.neck,
          safeEquipment.belt,
          safeEquipment.feet
        ].filter(Boolean); %>
        <% if (equippedItems.length === 0) { %>
          <div style="color: var(--text-dim); font-size: 0.85rem;">No gear currently equipped.</div>
        <% } else { %>
          <div class="gear-list-container">
            <% equippedItems.forEach(item => { %>
              <div class="gear-row-item">
                <div class="gear-item-info">
                  <div class="gear-item-name">
                    <strong>[<%= item.equipped_slot %>]</strong> <%= item.name %> <%= item.is_magical ? '✨' : '' %>
                    <% if (item.rarity) { %>
                      <span class="rarity-badge rarity-<%= item.rarity.toLowerCase() %>"><%= item.rarity %></span>
                    <% } %>
                  </div>
                  <div class="gear-item-meta">
                    <%= item.category %><%= item.subtype ? (' (' + item.subtype + ')') : '' %>
                  </div>
                  <% if (item.description) { %>
                    <div class="item-desc-text"><%= item.description %></div>
                  <% } %>
                </div>
                <form action="/game/inventory/unequip" method="POST" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <input type="hidden" name="itemInstanceId" value="<%= item.id || item.instance_id %>">
                  <input type="hidden" name="returnModal" value="backpack">
                  <button type="submit" class="btn btn-subtle" <% if (isEquipLocked) { %>disabled title="Cannot change gear during combat or unresolved encounter"<% } %>>Unequip</button>
                </form>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Backpack Items (Non-potion gear & treasures) -->
      <div class="modal-section-group">
        <h3 class="modal-subheading">Backpack Armaments, Relics & Treasures (<%= backpackGear.length %> items)</h3>
        <% if (backpackGear.length === 0) { %>
          <div style="color: var(--text-dim); font-size: 0.85rem;">No unequipped gear, relics, or treasures in your backpack. Potion supplies are cataloged below.</div>
        <% } else { %>
          <div class="gear-list-container">
            <% backpackGear.forEach(item => { %>
              <%
                let derivedSlot = '';
                if (item.category === 'WEAPON') {
                  derivedSlot = item.weapon_range_type === 'RANGED' ? 'RANGED' : 'MELEE';
                } else if (item.category === 'ARMOR') {
                  derivedSlot = 'ARMOR';
                } else if (item.category === 'SHIELD') {
                  derivedSlot = 'SHIELD';
                } else if (item.equip_slot && ['RING', 'CLOAK', 'NECK', 'BELT', 'FEET'].includes(item.equip_slot.toUpperCase())) {
                  derivedSlot = item.equip_slot.toUpperCase();
                }
              %>
              <div class="gear-row-item">
                <div class="gear-item-info">
                  <div class="gear-item-name">
                    <%= item.name %> <%= item.is_magical ? '✨' : '' %>
                    <% if (item.rarity) { %>
                      <span class="rarity-badge rarity-<%= item.rarity.toLowerCase() %>"><%= item.rarity %></span>
                    <% } %>
                  </div>
                  <div class="gear-item-meta">
                    <%= item.category %><%= item.subtype ? (' (' + item.subtype + ')') : '' %>
                  </div>
                  <% if (item.subtype === 'TREASURE') { %>
                    <% const treasureSellValue = (item.sell_price !== null && item.sell_price !== undefined) ? Number(item.sell_price) : Math.floor((item.buy_price || 0) * 0.5); %>
                    <div style="font-size: 0.8rem; color: var(--accent-gold); font-weight: bold; margin-top: 2px;">
                      Appraised value: <%= treasureSellValue %> gp
                    </div>
                  <% } %>
                  <% if (item.description) { %>
                    <div class="item-desc-text"><%= item.description %></div>
                  <% } %>
                </div>
                <% if (derivedSlot) { %>
                  <form action="/game/inventory/equip" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <input type="hidden" name="itemInstanceId" value="<%= item.id %>">
                    <input type="hidden" name="targetSlot" value="<%= derivedSlot %>">
                    <input type="hidden" name="returnModal" value="backpack">
                    <button type="submit" class="btn btn-secondary" <% if (isEquipLocked) { %>disabled title="Cannot change gear during combat or unresolved encounter"<% } %>>Equip</button>
                  </form>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Potions List -->
      <div class="modal-section-group">
        <h3 class="modal-subheading">Potion Supplies (<%= safePotionCount %> total)</h3>
        <% if (safePotions.length === 0) { %>
          <div style="color: var(--text-dim); font-size: 0.85rem;">No potions in your possession.</div>
        <% } else { %>
          <div class="gear-list-container">
            <% safePotions.forEach(pot => { %>
              <div class="gear-row-item">
                <div class="gear-item-info">
                  <div class="gear-item-name">
                    🧪 <%= pot.name %> <%= pot.is_magical ? '✨' : '' %>
                    <% if (pot.rarity) { %>
                      <span class="rarity-badge rarity-<%= pot.rarity.toLowerCase() %>"><%= pot.rarity %></span>
                    <% } %>
                  </div>
                  <div class="gear-item-meta">
                    <% if (pot.is_inactive) { %>
                      <span style="color: #f59e0b;">Pending implementation — effect not yet active</span>
                    <% } else { %>
                      Restores vitality upon consumption
                    <% } %>
                  </div>
                  <% if (pot.description) { %>
                    <div class="item-desc-text"><%= pot.description %></div>
                  <% } %>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <% if (pot.is_inactive) { %>
                    <button type="button" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.8rem; opacity: 0.5; cursor: not-allowed;" disabled title="Effect pending future update">
                      Inactive
                    </button>
                  <% } else { %>
                    <form action="/game/inventory/use" method="POST" style="margin: 0;">
                      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                      <input type="hidden" name="itemInstanceId" value="<%= pot.id %>">
                      <input type="hidden" name="returnModal" value="backpack">
                      <button type="submit" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.8rem;" <% if (isEquipLocked || character.current_hp >= character.max_hp) { %>disabled title="<%= isEquipLocked ? 'Cannot use in combat or unresolved encounter' : 'HP already full' %>"<% } %>>
                        🧪 Drink
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- -------------------------------------------------------------------
       3. MARKET MODAL
       ------------------------------------------------------------------- -->
  <div class="game-modal-dialog" id="modal-market" role="dialog" aria-modal="true" aria-labelledby="modal-market-title" <%= safeActiveModal === 'market' ? '' : 'hidden' %>>
    <div class="game-modal-header">
      <h2 class="game-modal-title" id="modal-market-title">🛒 Town Market & Resale Hub</h2>
      <button type="button" class="game-modal-close" onclick="closeGameModal()" aria-label="Close dialog">✕</button>
    </div>
    <div class="game-modal-body">
      <% if (!safeIsSafeCity || !safeShopStock) { %>
        <div class="modal-notice-box">
          <div class="notice-title">🌲 Far from Civilization</div>
          <p>Merchant stalls and magical pawn auctions are only maintained within safe haven cities such as Oakhaven. Return to a safe haven to trade goods and purchase arms.</p>
        </div>
      <% } else { %>
        <%
          const standardItemsList = Array.isArray(safeShopStock.standardItems) ? safeShopStock.standardItems : [];
          const resaleItemsList = Array.isArray(safeShopStock.resaleListings) ? safeShopStock.resaleListings : [];
          const sellableItems = safeInventory.filter(item => !item.equipped_slot);

          const meleeWeapons = standardItemsList.filter(it => it.category === 'WEAPON' && it.weapon_range_type !== 'RANGED');
          const rangedWeapons = standardItemsList.filter(it => it.category === 'WEAPON' && it.weapon_range_type === 'RANGED');
          const armorItems = standardItemsList.filter(it => it.category === 'ARMOR');
          const shieldItems = standardItemsList.filter(it => it.category === 'SHIELD');
          const generalItems = standardItemsList.filter(it => it.category !== 'WEAPON' && it.category !== 'ARMOR' && it.category !== 'SHIELD');

          function formatShopItemSpecs(item) {
            const specs = [];
            if (item.category === 'WEAPON') {
              specs.push(Number(item.is_two_handed) === 1 ? 'Two-Handed' : 'One-Handed');
              if (item.subtype) {
                specs.push(item.subtype.replace(/_/g, ' '));
              }
            } else if (item.category === 'ARMOR' || item.category === 'SHIELD') {
              if (item.subtype) {
                specs.push(item.subtype.replace(/_/g, ' '));
              }
            } else if (item.subtype) {
              specs.push(item.subtype.replace(/_/g, ' '));
            }
            return specs.join(' • ');
          }

          function canHeroEquipItem(item, heroClass) {
            if (!item.allowed_classes) return true;
            try {
              const allowed = typeof item.allowed_classes === 'string' ? JSON.parse(item.allowed_classes) : item.allowed_classes;
              if (Array.isArray(allowed)) {
                return allowed.includes((heroClass || '').toUpperCase());
              }
            } catch (e) {}
            return true;
          }

          const marketSections = [
            { key: 'melee', title: '🗡️ Melee Weapons', items: meleeWeapons },
            { key: 'ranged', title: '🏹 Ranged Weapons', items: rangedWeapons },
            { key: 'armor', title: '🛡️ Armor', items: armorItems },
            { key: 'shield', title: '🔰 Shields', items: shieldItems },
            { key: 'items', title: '🧪 Items & Potions', items: generalItems }
          ];
        %>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; background: rgba(0,0,0,0.3); padding: 8px 12px; border-radius: 4px;">
          <span>Coin in purse:</span>
          <span style="font-family: var(--font-serif); font-size: 1.1rem; color: var(--accent-gold); font-weight: bold;"><%= character.gold %> gp</span>
        </div>

        <% if (safeInventory.length >= 50) { %>
          <div class="modal-notice-box" style="border: 1px solid #ef4444; background: rgba(239, 68, 68, 0.15); color: #fca5a5; margin-bottom: 10px;">
            <div class="notice-title" style="color: #ef4444;">⚠️ Backpack Full (<%= safeInventory.length %>/50)</div>
            <p>Your backpack is at or above capacity. Sell items to the merchant before purchasing new gear.</p>
          </div>
        <% } %>

        <!-- Market Category Tabs -->
        <div class="market-category-tabs" role="tablist" aria-label="Market Categories">
          <button type="button" class="market-tab-btn is-active" data-market-tab="melee" role="tab" aria-selected="true" onclick="switchMarketTab('melee')">
            <span>🗡️ Melee Weapons</span>
            <span class="market-tab-count"><%= meleeWeapons.length %></span>
          </button>
          <button type="button" class="market-tab-btn" data-market-tab="ranged" role="tab" aria-selected="false" onclick="switchMarketTab('ranged')">
            <span>🏹 Ranged Weapons</span>
            <span class="market-tab-count"><%= rangedWeapons.length %></span>
          </button>
          <button type="button" class="market-tab-btn" data-market-tab="armor" role="tab" aria-selected="false" onclick="switchMarketTab('armor')">
            <span>🛡️ Armor</span>
            <span class="market-tab-count"><%= armorItems.length %></span>
          </button>
          <button type="button" class="market-tab-btn" data-market-tab="shield" role="tab" aria-selected="false" onclick="switchMarketTab('shield')">
            <span>🔰 Shields</span>
            <span class="market-tab-count"><%= shieldItems.length %></span>
          </button>
          <button type="button" class="market-tab-btn" data-market-tab="items" role="tab" aria-selected="false" onclick="switchMarketTab('items')">
            <span>🧪 Items &amp; Potions</span>
            <span class="market-tab-count"><%= generalItems.length %></span>
          </button>
          <button type="button" class="market-tab-btn <%= resaleItemsList.length > 0 ? 'has-magical' : '' %>" data-market-tab="resale" role="tab" aria-selected="false" onclick="switchMarketTab('resale')">
            <span>✨ Magical Market</span>
            <span class="market-tab-count"><%= resaleItemsList.length %></span>
          </button>
          <button type="button" class="market-tab-btn" data-market-tab="sell" role="tab" aria-selected="false" onclick="switchMarketTab('sell')">
            <span>💰 Sell Goods</span>
            <span class="market-tab-count"><%= sellableItems.length %></span>
          </button>
        </div>

        <!-- Standard Armory & Supplies Category Panels -->
        <% marketSections.forEach(function(sec, idx) { %>
          <div class="modal-section-group market-category-panel" id="market-panel-<%= sec.key %>" data-market-panel="<%= sec.key %>" <%= idx === 0 ? '' : 'hidden' %>>
            <h3 class="modal-subheading"><%= sec.title %> (<%= sec.items.length %>)</h3>
            <% if (sec.items.length === 0) { %>
              <div style="color: var(--text-dim); font-size: 0.85rem; padding: 8px 0;">No items currently stocked in this category.</div>
            <% } else { %>
              <div class="gear-list-container">
                <% sec.items.forEach(item => { %>
                  <% const specStr = formatShopItemSpecs(item); %>
                  <% const equippable = canHeroEquipItem(item, character.class); %>
                  <div class="gear-row-item">
                    <div class="gear-item-info">
                      <div class="gear-item-name">
                        <%= item.name %>
                        <% if (item.rarity) { %>
                          <span class="rarity-badge rarity-<%= item.rarity.toLowerCase() %>"><%= item.rarity %></span>
                        <% } %>
                        <% if (!equippable) { %>
                          <span class="market-class-warn-badge" title="Your class (<%= character.class %>) cannot equip this item">Unusable by <%= character.class %></span>
                        <% } %>
                      </div>
                      <div class="gear-item-meta">
                        <strong style="color: var(--accent-gold);"><%= item.buy_price %> gp</strong>
                        <% if (specStr) { %>
                          <span> • <%= specStr %></span>
                        <% } %>
                      </div>
                      <% if (item.description) { %>
                        <div class="item-desc-text"><%= item.description %></div>
                      <% } %>
                    </div>
                    <form action="/game/shop/buy" method="POST" style="margin: 0;">
                      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                      <input type="hidden" name="itemDefinitionId" value="<%= item.id %>">
                      <input type="hidden" name="returnModal" value="market">
                      <button type="submit" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.8rem;" <% if (character.gold < item.buy_price || safeInventory.length >= 50) { %>disabled title="<%= safeInventory.length >= 50 ? 'Backpack full' : 'Insufficient gold' %>"<% } %>>Buy</button>
                    </form>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>

        <!-- Global Magical Resale Market Panel -->
        <div class="modal-section-group market-category-panel" id="market-panel-resale" data-market-panel="resale" hidden>
          <h3 class="modal-subheading" style="color: #b794f4;">✨ Global Magical Resale Market (<%= resaleItemsList.length %>)</h3>
          <% if (resaleItemsList.length === 0) { %>
            <div style="color: var(--text-dim); font-size: 0.85rem; padding: 8px 0;">No enchanted artifacts are currently offered on the shared realm market. Magical items sold by heroes in any safe city appear here for all adventurers to claim.</div>
          <% } else { %>
            <div class="gear-list-container">
              <% resaleItemsList.forEach(item => { %>
                <% const specStr = formatShopItemSpecs(item); %>
                <div class="gear-row-item" style="border: 1px solid rgba(139, 92, 246, 0.3); background: rgba(76, 29, 149, 0.15);">
                  <div class="gear-item-info">
                    <div class="gear-item-name" style="color: #d6bcfa;">
                      <%= item.name %> ✨
                      <% if (item.rarity) { %>
                        <span class="rarity-badge rarity-<%= item.rarity.toLowerCase() %>"><%= item.rarity %></span>
                      <% } %>
                    </div>
                    <div class="gear-item-meta">
                      <strong style="color: var(--accent-gold);"><%= item.resale_price %> gp</strong>
                      <% if (specStr) { %>
                        <span> • <%= specStr %></span>
                      <% } %>
                    </div>
                    <% if (item.description) { %>
                      <div class="item-desc-text"><%= item.description %></div>
                    <% } %>
                  </div>
                  <form action="/game/shop/buy" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <input type="hidden" name="listingId" value="<%= item.listing_id %>">
                    <input type="hidden" name="returnModal" value="market">
                    <button type="submit" class="btn btn-primary" style="padding: 4px 10px; font-size: 0.8rem;" <% if (character.gold < item.resale_price || safeInventory.length >= 50) { %>disabled title="<%= safeInventory.length >= 50 ? 'Backpack full' : 'Insufficient gold' %>"<% } %>>Buy</button>
                  </form>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <!-- Sell from Backpack Panel -->
        <div class="modal-section-group market-category-panel" id="market-panel-sell" data-market-panel="sell" hidden>
          <h3 class="modal-subheading">💰 Sell Goods from Backpack (<%= sellableItems.length %>)</h3>
          <% if (sellableItems.length === 0) { %>
            <div style="color: var(--text-dim); font-size: 0.85rem; padding: 8px 0;">You have no unequipped items in your backpack to sell. Unequip gear in your Backpack first if you wish to sell it.</div>
          <% } else { %>
            <div class="gear-list-container">
              <% sellableItems.forEach(item => { %>
                <% const payout = (item.is_magical && item.category !== 'POTION')
                  ? Math.floor((item.buy_price || 0) * 0.4)
                  : ((item.sell_price !== null && item.sell_price !== undefined) ? Number(item.sell_price) : Math.floor((item.buy_price || 0) * 0.5)); %>
                <div class="gear-row-item">
                  <div class="gear-item-info">
                    <div class="gear-item-name">
                      <%= item.name %> <%= item.is_magical ? '✨' : '' %>
                      <% if (item.rarity) { %>
                        <span class="rarity-badge rarity-<%= item.rarity.toLowerCase() %>"><%= item.rarity %></span>
                      <% } %>
                    </div>
                    <div class="gear-item-meta" style="color: #68d391;">
                      Payout: <%= payout %> gp • <%= item.category %> <%= item.subtype ? ('(' + item.subtype + ')') : '' %>
                    </div>
                    <% if (item.description) { %>
                      <div class="item-desc-text"><%= item.description %></div>
                    <% } %>
                  </div>
                  <form action="/game/shop/sell" method="POST" style="margin: 0;">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <input type="hidden" name="itemInstanceId" value="<%= item.id %>">
                    <input type="hidden" name="returnModal" value="market">
                    <button type="submit" class="btn btn-subtle" style="padding: 4px 10px; font-size: 0.8rem;">Sell</button>
                  </form>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- -------------------------------------------------------------------
       4. JOURNAL MODAL
       ------------------------------------------------------------------- -->
  <div class="game-modal-dialog" id="modal-journal" role="dialog" aria-modal="true" aria-labelledby="modal-journal-title" <%= safeActiveModal === 'journal' ? '' : 'hidden' %>>
    <div class="game-modal-header">
      <h2 class="game-modal-title" id="modal-journal-title">📜 Adventurer's Journal & Chronicles</h2>
      <button type="button" class="game-modal-close" onclick="closeGameModal()" aria-label="Close dialog">✕</button>
    </div>
    <div class="game-modal-body">
      <div class="modal-section-group">
        <h3 class="modal-subheading">Current Expedition</h3>
        <div class="journal-entry-card">
          <div class="journal-entry-header">
            <span>📍 <%= currentTile.name %></span>
            <span class="panel-coords">[X: <%= currentTile.x %>, Y: <%= currentTile.y %>]</span>
          </div>
          <p style="font-size: 0.9rem; font-style: italic; color: #ddd;"><%= currentTile.description %></p>
        </div>
      </div>

      <% if (safeActiveContract) { %>
        <div class="modal-section-group">
          <h3 class="modal-subheading">Active Hunting Contract</h3>
          <div class="journal-entry-card active-contract-journal-card">
            <div class="journal-entry-header">
              <strong>🎯 <%= safeActiveContract.contract_title %></strong>
              <span class="badge <%= safeActiveContract.status === 'READY_TO_CLAIM' ? 'badge-safe' : 'badge-danger' %>">
                <%= safeActiveContract.status === 'READY_TO_CLAIM' ? 'TARGET SLAIN' : 'ACTIVE HUNT' %>
              </span>
            </div>
            <p style="font-size: 0.85rem; color: #ccc; margin: 6px 0;"><%= isStage1Secrecy ? 'A sanctioned Oakhaven warrant for a dangerous quarry in the wilds.' : safeActiveContract.contract_description %></p>
            <div style="font-size: 0.82rem; color: var(--text-muted); display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px;">
              <% if (safeActiveContract.status === 'READY_TO_CLAIM') { %>
                <span style="color: #68d391;">✔ Slain: <strong><%= isStage1Secrecy ? 'Hunted Quarry' : safeActiveContract.custom_name %></strong></span>
                <span style="color: var(--accent-gold);">🏛️ Return alive to Oakhaven to collect <strong><%= safeActiveContract.reward_gold %> Gold</strong></span>
              <% } else { %>
                <span>Target: <strong style="color: var(--text-heading);"><%= isStage1Secrecy ? 'Dangerous Quarry' : ('Dangerous ' + safeActiveContract.base_monster_name) %></strong></span>
                <span>Region: <strong style="color: var(--text-heading);"><%= safeActiveContract.target_region %></strong></span>
                <span>Threat: <strong style="color: #f87171;"><%= safeActiveContract.threat_label || 'Dangerous' %></strong></span>
                <span>Reward: <strong style="color: var(--accent-gold);"><%= safeActiveContract.reward_gold %> Gold</strong></span>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>

      <div class="modal-section-group">
        <h3 class="modal-subheading">Recorded Battles & Encounters</h3>
        <% if (safeJournal.length === 0) { %>
          <div style="color: var(--text-dim); font-size: 0.85rem;">No recorded combat encounters in this chronicle yet. Venture forth into the unknown to carve your legend.</div>
        <% } else { %>
          <div class="journal-log-list">
            <% safeJournal.forEach(entry => { %>
              <div class="journal-entry-card">
                <div class="journal-entry-header">
                  <strong><%= entry.monster_name || 'Unknown Threat' %></strong>
                  <span class="badge <%= entry.status === 'VICTORY' ? 'badge-safe' : (entry.status === 'ESCAPED' ? 'badge-terrain' : 'badge-danger') %>">
                    <%= entry.status %>
                  </span>
                </div>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">
                  Location: <%= entry.tile_name || 'Wilderness' %> • Rounds: <%= entry.combat_round || 1 %>
                </div>
                <% if (entry.victory_text) { %>
                  <div style="font-size: 0.85rem; color: var(--accent-gold);">
                    <%= entry.victory_text %>
                  </div>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- -------------------------------------------------------------------
       5. THE WATCHER'S BOARD MODAL (BOUNTIES & WILDERNESS THREATS)
       ------------------------------------------------------------------- -->
  <div class="game-modal-dialog" id="modal-bounties" role="dialog" aria-modal="true" aria-labelledby="modal-bounties-title" <%= safeActiveModal === 'bounties' ? '' : 'hidden' %>>
    <div class="game-modal-header">
      <h2 class="game-modal-title" id="modal-bounties-title">🎯 The Watcher's Board — Oakhaven Garrison</h2>
      <button type="button" class="game-modal-close" onclick="closeGameModal()" aria-label="Close dialog">✕</button>
    </div>
    <div class="game-modal-body">
      <% if (!safeIsSafeCity) { %>
        <div class="market-locked-notice">
          <div class="locked-icon">🏛️</div>
          <h3>Available Only at the Oakhaven Garrison</h3>
          <p>You must stand within the walls of <strong>Oakhaven</strong> to inspect posted warrants or accept new hunting contracts.</p>
        </div>
      <% } else { %>
        <!-- SECTION A: HUNTING CONTRACTS -->
        <div class="modal-section-group" id="watcher-hunting-contracts-section">
          <div class="watcher-section-header">
            <div>
              <h3 class="modal-subheading" style="margin-bottom: 2px;">A. Hunting Contracts</h3>
              <p class="watcher-section-desc">Sanctioned warrants posted by the Watchers of Oakhaven. Only one contract may be active at a time. Return alive after slaying your quarry to claim the bounty.</p>
            </div>
          </div>

          <% if (safeBountyContracts.length === 0) { %>
            <div style="color: var(--text-dim); font-size: 0.85rem; padding: 12px 0;">
              No hunting contracts are currently posted for your rank. Check back after your next expedition.
            </div>
          <% } else { %>
            <div class="watcher-contracts-grid">
              <% safeBountyContracts.forEach(function(contract) {
                const isThisActive = contract.status === 'ACTIVE' || contract.status === 'READY_TO_CLAIM';
                const isCompleted = contract.status === 'COMPLETED';
                const isAbandoned = contract.status === 'ABANDONED';
                const isFailed = contract.status === 'FAILED';
                const canAccept = contract.status === 'AVAILABLE' && !safeActiveContract;
              %>
                <div class="watcher-contract-card status-<%= (contract.status || 'available').toLowerCase() %>" data-contract-id="<%= contract.id %>">
                  <div class="watcher-contract-top">
                    <div class="watcher-contract-title-row">
                      <h4 class="watcher-contract-title"><%= contract.contract_title %></h4>
                      <span class="watcher-contract-badge badge-<%= (contract.status || 'available').toLowerCase() %>">
                        <% if (contract.status === 'ACTIVE') { %>Active Contract<% } %>
                        <% if (contract.status === 'READY_TO_CLAIM') { %>Ready to Claim<% } %>
                        <% if (contract.status === 'AVAILABLE') { %>Available<% } %>
                        <% if (contract.status === 'COMPLETED') { %>Completed<% } %>
                        <% if (contract.status === 'ABANDONED') { %>Abandoned<% } %>
                        <% if (contract.status === 'FAILED') { %>Failed<% } %>
                      </span>
                    </div>
                    <p class="watcher-contract-desc">“<%= isStage1Secrecy ? 'Travelers report a dangerous quarry terrorizing the frontier.' : contract.contract_description %>”</p>
                  </div>

                  <div class="watcher-contract-meta">
                    <div class="contract-meta-row">
                      <span class="meta-label">Target:</span>
                      <strong class="meta-value"><%= isStage1Secrecy ? 'Dangerous Quarry' : ('Dangerous ' + contract.base_monster_name) %></strong>
                    </div>
                    <div class="contract-meta-row">
                      <span class="meta-label">Region:</span>
                      <strong class="meta-value"><%= contract.target_region %><%= contract.compass_direction && contract.compass_direction !== 'In Oakhaven' ? (' (' + contract.compass_direction + ')') : '' %></strong>
                    </div>
                    <div class="contract-meta-row">
                      <span class="meta-label">Threat:</span>
                      <strong class="meta-value threat-level-text"><%= contract.threat_label || 'Dangerous' %></strong>
                    </div>
                    <div class="contract-meta-row">
                      <span class="meta-label">Reward:</span>
                      <strong class="meta-value reward-gold-text">🪙 <%= contract.reward_gold %> Gold</strong>
                    </div>
                  </div>

                  <div class="watcher-contract-actions">
                    <% if (isThisActive) { %>
                      <form action="/game/bounties/abandon" method="POST" style="margin: 0; width: 100%;">
                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                        <input type="hidden" name="contractId" value="<%= contract.id %>">
                        <button type="submit" class="btn btn-subtle" style="width: 100%;">Abandon Contract</button>
                      </form>
                    <% } else if (contract.status === 'AVAILABLE') { %>
                      <% if (canAccept) { %>
                        <form action="/game/bounties/accept" method="POST" style="margin: 0; width: 100%;">
                          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                          <input type="hidden" name="contractId" value="<%= contract.id %>">
                          <button type="submit" class="btn btn-primary" style="width: 100%;">Accept Contract</button>
                        </form>
                      <% } else { %>
                        <button type="button" class="btn btn-subtle" disabled style="width: 100%; opacity: 0.5; cursor: not-allowed;" title="Complete or abandon your active contract first">
                          Another Contract Active
                        </button>
                      <% } %>
                    <% } else if (isCompleted) { %>
                      <div class="contract-settled-label" style="color: #68d391;">✔ Bounty Claimed</div>
                    <% } else if (isAbandoned) { %>
                      <div class="contract-settled-label" style="color: var(--text-dim);">✕ Warrant Forfeited</div>
                    <% } else if (isFailed) { %>
                      <div class="contract-settled-label" style="color: #f87171;">💀 Contract Failed</div>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <!-- SECTION B: THREATS IN THE WILDERNESS -->
        <div class="modal-section-group" id="watcher-wilderness-threats-section" style="margin-top: 22px;">
          <div class="watcher-section-header">
            <div>
              <h3 class="modal-subheading" style="margin-bottom: 2px;">B. Threats in the Wilderness</h3>
              <p class="watcher-section-desc">Ominous reports of enduring horrors that have slain heroes in the wilds. The Watchers know only the direction and the toll of the fallen—never the exact creature awaiting in the dark.</p>
            </div>
          </div>

          <% if (safeWildernessThreats.length === 0) { %>
            <div class="wilderness-threats-empty">
              <span>🕯️</span>
              <span>No enduring slayers of heroes are currently reported in the surrounding wilds.</span>
            </div>
          <% } else { %>
            <div class="wilderness-threats-list">
              <% safeWildernessThreats.forEach(function(threat) { %>
                <div class="wilderness-threat-card">
                  <div class="threat-card-header">
                    <span class="threat-direction-title">💀 Threat to the <%= threat.direction %></span>
                    <span class="threat-severity-badge"><%= threat.severity %></span>
                  </div>
                  <p class="threat-rumor-text">“<%= threat.rumor %>”</p>
                  <div class="threat-card-footer">
                    <span class="threat-kill-toll">Heroes Fallen: <strong><%= threat.killCount %></strong></span>
                    <span class="threat-Location-vague">Direction from Oakhaven: <strong><%= threat.direction %></strong></span>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- =====================================================================
     CLIENT-SIDE SCRIPT FOR MODALS & ACCESSIBILITY
     ===================================================================== -->
<script>
  let lastFocusedElement = null;

  function openGameModal(modalName) {
    var backdrop = document.getElementById('game-modal-backdrop');
    if (!backdrop) return;

    lastFocusedElement = document.activeElement;

    var allModals = backdrop.querySelectorAll('.game-modal-dialog');
    allModals.forEach(function(m) {
      m.hidden = true;
      m.setAttribute('aria-hidden', 'true');
    });

    var targetModal = document.getElementById('modal-' + modalName);
    if (!targetModal) return;

    backdrop.hidden = false;
    backdrop.classList.add('is-active');
    targetModal.hidden = false;
    targetModal.setAttribute('aria-hidden', 'false');

    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', '#' + modalName);
    }

    var focusable = targetModal.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (focusable) {
      focusable.focus();
    }
  }

  function closeGameModal() {
    var backdrop = document.getElementById('game-modal-backdrop');
    if (!backdrop) return;

    var allModals = backdrop.querySelectorAll('.game-modal-dialog');
    allModals.forEach(function(m) {
      m.hidden = true;
      m.setAttribute('aria-hidden', 'true');
    });

    backdrop.hidden = true;
    backdrop.classList.remove('is-active');

    if (window.history && window.history.replaceState) {
      var cleanUrl = window.location.pathname + window.location.search.replace(/[?&]modal=[^&]*/, '');
      window.history.replaceState(null, '', cleanUrl);
    }

    if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
      lastFocusedElement.focus();
    }
  }

  function handleBackdropClick(e) {
    if (e.target && e.target.id === 'game-modal-backdrop') {
      closeGameModal();
    }
  }

  var isSubmittingMove = false;

  document.addEventListener('keydown', function(e) {
    var backdrop = document.getElementById('game-modal-backdrop');
    var isModalOpen = backdrop && !backdrop.hidden;

    if (e.key === 'Escape') {
      if (isModalOpen) {
        closeGameModal();
      }
      return;
    }

    // Ignore movement keys if modal is open, modifier keys are held, key is repeating, or user is focused in an input/select/textarea
    if (isModalOpen || isSubmittingMove || e.repeat || e.ctrlKey || e.altKey || e.metaKey) {
      return;
    }

    var activeTag = document.activeElement ? document.activeElement.tagName : '';
    if (activeTag === 'INPUT' || activeTag === 'SELECT' || activeTag === 'TEXTAREA' || (document.activeElement && document.activeElement.isContentEditable)) {
      return;
    }

    var directionClass = null;
    switch (e.key) {
      case 'w':
      case 'W':
      case 'ArrowUp':
        directionClass = '.compass-north';
        break;
      case 's':
      case 'S':
      case 'ArrowDown':
        directionClass = '.compass-south';
        break;
      case 'a':
      case 'A':
      case 'ArrowLeft':
        directionClass = '.compass-west';
        break;
      case 'd':
      case 'D':
      case 'ArrowRight':
        directionClass = '.compass-east';
        break;
    }

    if (directionClass) {
      var form = document.querySelector(directionClass);
      if (form) {
        var btn = form.querySelector('button[type="submit"]');
        if (btn && !btn.disabled) {
          e.preventDefault();
          isSubmittingMove = true;
          form.submit();
        }
      }
    }
  });

  function switchMarketTab(tabKey) {
    var marketModal = document.getElementById('modal-market');
    if (!marketModal) return;

    var tabs = marketModal.querySelectorAll('.market-tab-btn');
    tabs.forEach(function(btn) {
      var isMatch = btn.getAttribute('data-market-tab') === tabKey;
      btn.classList.toggle('is-active', isMatch);
      btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
    });

    var panels = marketModal.querySelectorAll('.market-category-panel');
    panels.forEach(function(panel) {
      var isMatch = panel.getAttribute('data-market-panel') === tabKey;
      panel.hidden = !isMatch;
    });

    try {
      window.sessionStorage.setItem('darkgrid_market_tab', tabKey);
    } catch (e) {}
  }

  document.addEventListener('DOMContentLoaded', function() {
    try {
      var savedMarketTab = window.sessionStorage.getItem('darkgrid_market_tab');
      if (savedMarketTab && ['melee', 'ranged', 'armor', 'shield', 'items', 'resale', 'sell'].indexOf(savedMarketTab) !== -1) {
        switchMarketTab(savedMarketTab);
      }
    } catch (e) {}

    var initialModal = <%- JSON.stringify(safeActiveModal) %>;
    var hash = window.location.hash ? window.location.hash.substring(1) : null;
    var toOpen = initialModal || hash;
    if (toOpen && ['character', 'backpack', 'market', 'journal', 'bounties'].indexOf(toOpen) !== -1) {
      openGameModal(toOpen);
    }
  });
</script>

<%- include('partials/footer') %>
