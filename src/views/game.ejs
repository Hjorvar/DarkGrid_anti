<%- include('partials/header') %>
<%
  const safePotionCount = (typeof potionCount !== 'undefined' && potionCount !== null) ? potionCount : 0;
  const safeCombatState = (typeof combatState !== 'undefined' && combatState !== null) ? combatState : null;
  const safeEquipment = (typeof equipment !== 'undefined' && equipment !== null) ? equipment : null;
%>

<div class="game-viewport">
  <!-- Feedback alerts -->
  <% if (errorMessage) { %>
    <div class="alert alert-error">
      <span class="alert-icon">⚠️</span>
      <span><%= errorMessage %></span>
    </div>
  <% } %>
  <% if (infoMessage) { %>
    <div class="alert alert-info">
      <span class="alert-icon">🕯️</span>
      <span><%= infoMessage %></span>
    </div>
  <% } %>

  <!-- Top Area Header -->
  <div class="area-header-card">
    <div class="area-title-group">
      <h1><%= currentTile.name %></h1>
      <div class="area-meta-badges">
        <span class="badge badge-terrain"><%= currentTile.terrain %></span>
        <% if (currentTile.is_safe === 1) { %>
          <span class="badge badge-safe">Safe Haven (Peaceful)</span>
        <% } else { %>
          <span class="badge badge-danger">Unexplored Wilderness</span>
        <% } %>
        <% if (currentTile.feature) { %>
          <span class="badge badge-feature"><%= currentTile.feature %></span>
        <% } %>
      </div>
    </div>
    <div class="area-coords">
      Coordinates: [X: <%= currentTile.x %>, Y: <%= currentTile.y %>]
    </div>
  </div>

  <!-- Main Game Layout -->
  <div class="game-grid">
    <!-- Left Column: Story, Encounter, Actions -->
    <div class="story-panel">
      <!-- Tile Narrative -->
      <div class="tile-narrative">
        <div class="narrative-quote-icon">“</div>
        <div class="narrative-body"><%= currentTile.description %></div>
      </div>

      <!-- Active Encounter Section (if any) -->
      <% if (encounter) { %>
        <% 
          const isRevealed = (encounter.status === 'IN_COMBAT');
          const cleanMonsterName = isRevealed ? (encounter.monster_name || '').replace(/\[.*?\]/g, '').trim() : '';
          const cleanSlug = isRevealed ? (encounter.imageSlug || cleanMonsterName.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '')) : '';
          const monsterImgUrl = isRevealed ? (encounter.imageUrl || ('/images/monsters/' + cleanSlug + '.png')) : null;
        %>
        <div class="encounter-card <%= isRevealed ? 'in-combat' : 'is-hidden-threat' %>">
          <div class="encounter-content-layout">
            <!-- Monster Artwork Frame -->
            <div class="monster-art-container">
              <div class="monster-art-frame <%= !isRevealed ? 'mystery-art-frame' : '' %>">
                <% if (!isRevealed) { %>
                  <!-- Stage 1: Unknown Threat (All identifying details hidden) -->
                  <div class="mystery-placeholder">
                    <div class="mystery-fog-overlay"></div>
                    <div class="placeholder-rune mystery-rune">ᚦ</div>
                    <div class="mystery-symbol">?</div>
                    <div class="placeholder-label">Unknown Threat</div>
                    <div class="placeholder-sublabel">Shadows and rustling in the dark</div>
                  </div>
                <% } else { %>
                  <!-- Stage 2: Revealed Monster -->
                  <% if (monsterImgUrl) { %>
                    <img src="<%= monsterImgUrl %>" alt="<%= cleanMonsterName %>" class="monster-art-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="monster-placeholder" style="display: none;">
                      <div class="placeholder-rune">ᚱ</div>
                      <div class="placeholder-symbol" style="color: <%= encounter.monster_color || 'var(--accent-gold)' %>;">
                        <%= encounter.monster_symbol %>
                      </div>
                      <div class="placeholder-label"><%= cleanMonsterName %></div>
                      <div class="placeholder-sublabel">Revealed Threat</div>
                    </div>
                  <% } else { %>
                    <div class="monster-placeholder">
                      <div class="placeholder-rune">ᚱ</div>
                      <div class="placeholder-symbol" style="color: <%= encounter.monster_color || 'var(--accent-gold)' %>;">
                        <%= encounter.monster_symbol %>
                      </div>
                      <div class="placeholder-label"><%= cleanMonsterName %></div>
                      <div class="placeholder-sublabel">Revealed Threat</div>
                    </div>
                  <% } %>
                <% } %>
                <div class="monster-art-vignette"></div>
              </div>
            </div>

            <!-- Monster Lore & Actions -->
            <div class="encounter-details">
              <div class="encounter-header">
                <div class="encounter-title">
                  <% if (!isRevealed) { %>
                    <span class="encounter-symbol-badge mystery-badge">[?]</span>
                    <span>Unknown Threat: <em>Obscure shape in the shadows</em></span>
                  <% } else { %>
                    <span class="encounter-symbol-badge" style="color: <%= encounter.monster_color || 'var(--accent-crimson)' %>;">
                      [<%= encounter.monster_symbol %>]
                    </span>
                    <span>Revealed Threat: <strong><%= cleanMonsterName %></strong></span>
                  <% } %>
                </div>

                <% if (encounter.isRangerSpecial) { %>
                  <% if (!isRevealed) { %>
                    <span class="ranger-badge">🏹 Ranger perceives a clue</span>
                  <% } else { %>
                    <span class="ranger-badge">🏹 Ranger at close quarters</span>
                  <% } %>
                <% } %>
              </div>

              <p class="encounter-text">
                <%= encounter.resolvedDescription %>
              </p>

              <% if (!isRevealed) { %>
                <!-- Stage 1 Actions: Player decides to Investigate or Ignore -->
                <div class="encounter-actions">
                  <form action="/game/encounter/investigate" method="POST">
                    <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                    <button type="submit" class="btn btn-primary">
                      Advance & Investigate
                    </button>
                  </form>

                  <form action="/game/encounter/ignore" method="POST">
                    <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                    <button type="submit" class="btn btn-secondary">
                      Bypass & Ignore
                    </button>
                  </form>
                </div>
              <% } else { %>
                <!-- Stage 2 Combat Interface: Turn-Based Actions & Combat Log -->
                <% if (safeCombatState && safeCombatState.currentConditionText) { %>
                  <div class="monster-condition-box" style="margin: 12px 0; padding: 10px 14px; background: rgba(35, 20, 20, 0.7); border-left: 3px solid var(--accent-gold); font-style: italic; color: #ddd; font-size: 0.95rem; border-radius: 4px;">
                    “<%= safeCombatState.currentConditionText %>”
                  </div>
                <% } %>

                <% if (safeCombatState && safeCombatState.events && safeCombatState.events.length > 0) { %>
                  <div class="combat-log-container" style="margin: 14px 0; padding: 12px; background: rgba(10, 10, 15, 0.85); border: 1px solid var(--border-dark); border-radius: 6px; max-height: 220px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-gold); border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 4px;">
                      Battle Record (Round <%= encounter.combat_round || 1 %>)
                    </div>
                    <% safeCombatState.events.slice(-6).forEach(function(ev) { %>
                      <div class="combat-event-row" style="font-size: 0.9rem; line-height: 1.4; color: <%= ev.event_type === 'DEATH' ? 'var(--accent-crimson)' : (ev.event_type === 'VICTORY' ? 'var(--accent-gold)' : (ev.event_type === 'HERO_ATTACK' ? '#7cc' : (ev.event_type === 'MONSTER_ATTACK' ? '#e88' : '#bbb'))) %>;">
                        <% if (ev.event_type === 'HERO_ATTACK') { %>⚔️ <% } %>
                        <% if (ev.event_type === 'MONSTER_ATTACK') { %>🩸 <% } %>
                        <% if (ev.event_type === 'POTION_USED') { %>🧪 <% } %>
                        <% if (ev.event_type === 'FLEE') { %>🏃 <% } %>
                        <% if (ev.event_type === 'MONSTER_CONDITION') { %>⚠️ <% } %>
                        <span><%= ev.public_text %></span>
                      </div>
                    <% }); %>
                  </div>
                <% } %>

                <div class="encounter-actions combat-actions-grid" style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px;">
                  <!-- Action 1: Attack -->
                  <form action="/game/combat/attack" method="POST" style="flex: 1; min-width: 130px;">
                    <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                    <input type="hidden" name="round" value="<%= encounter.combat_round || 1 %>">
                    <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; font-weight: bold; background: #881a1a; border-color: #a82020;">
                      ⚔️ Attack
                    </button>
                  </form>

                  <!-- Action 2: Drink Potion -->
                  <form action="/game/combat/potion" method="POST" style="flex: 1; min-width: 130px;">
                    <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                    <input type="hidden" name="round" value="<%= encounter.combat_round || 1 %>">
                    <button type="submit" class="btn btn-secondary" <%= (!safePotionCount || safePotionCount <= 0) ? 'disabled' : '' %> style="width: 100%; justify-content: center;">
                      🧪 Drink Potion (<%= safePotionCount %>)
                    </button>
                  </form>

                  <!-- Action 3: Flee -->
                  <form action="/game/combat/flee" method="POST" style="flex: 1; min-width: 110px;" onsubmit="return confirm('Fleeing triggers a free Attack of Opportunity from the monster. Are you certain you wish to flee?');">
                    <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                    <button type="submit" class="btn btn-secondary" style="width: 100%; justify-content: center; border-color: #555;">
                      🏃 Flee
                    </button>
                  </form>

                  <!-- Hidden fallback for Phase 1 conclude standoff compatibility -->
                  <form action="/game/encounter/conclude" method="POST" style="display: none;" aria-hidden="true">
                    <input type="hidden" name="encounterId" value="<%= encounter.id %>">
                    <button type="submit">Withdraw Carefully</button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Movement Compass Controls -->
      <div class="movement-section">
        <h2 class="section-title">Navigation (Movement)</h2>

        <% if (encounter && encounter.status === 'DISCOVERED') { %>
          <div class="encounter-lock-banner">
            ⚠️ You cannot move until you address the encounter (Investigate or Ignore).
          </div>
        <% } else if (encounter && encounter.status === 'IN_COMBAT') { %>
          <div class="encounter-lock-banner">
            ⚠️ You are in close quarters with the threat. Conclude combat or withdraw carefully.
          </div>
        <% } %>

        <div class="compass-rose-container">
          <div class="compass-grid">
            <!-- North -->
            <form action="/game/move" method="POST" class="compass-north">
              <input type="hidden" name="direction" value="NORTH">
              <button type="submit" class="compass-btn" 
                <%= (!directions.NORTH.available || encounter) ? 'disabled' : '' %>
                title="<%= directions.NORTH.available ? directions.NORTH.tileName : directions.NORTH.reason %>">
              <span class="compass-arrow">▲</span>
              <span class="compass-dir-name">North</span>
              </button>
            </form>

            <!-- West -->
            <form action="/game/move" method="POST" class="compass-west">
              <input type="hidden" name="direction" value="WEST">
              <button type="submit" class="compass-btn" 
                <%= (!directions.WEST.available || encounter) ? 'disabled' : '' %>
                title="<%= directions.WEST.available ? directions.WEST.tileName : directions.WEST.reason %>">
              <span class="compass-arrow">◀</span>
              <span class="compass-dir-name">West</span>
              </button>
            </form>

            <!-- Center marker -->
            <div class="compass-center" title="Current Location">
              <span class="compass-rose-glyph">✦</span>
            </div>

            <!-- East -->
            <form action="/game/move" method="POST" class="compass-east">
              <input type="hidden" name="direction" value="EAST">
              <button type="submit" class="compass-btn" 
                <%= (!directions.EAST.available || encounter) ? 'disabled' : '' %>
                title="<%= directions.EAST.available ? directions.EAST.tileName : directions.EAST.reason %>">
              <span class="compass-arrow">▶</span>
              <span class="compass-dir-name">East</span>
              </button>
            </form>

            <!-- South -->
            <form action="/game/move" method="POST" class="compass-south">
              <input type="hidden" name="direction" value="SOUTH">
              <button type="submit" class="compass-btn" 
                <%= (!directions.SOUTH.available || encounter) ? 'disabled' : '' %>
                title="<%= directions.SOUTH.available ? directions.SOUTH.tileName : directions.SOUTH.reason %>">
              <span class="compass-arrow">▼</span>
              <span class="compass-dir-name">South</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Minimap & Hero Sheet -->
    <div class="sidebar-panel">
      <!-- 5x5 Minimap -->
      <div class="minimap-card">
        <h3 class="section-title">Minimap (5×5)</h3>
        
        <div class="minimap-grid">
          <% minimap.rows.forEach(function(row) { %>
            <div class="minimap-row">
              <% row.forEach(function(cell) { %>
                <div class="minimap-cell <%= cell.isPlayer ? 'is-player' : '' %> <%= !cell.isPassable ? 'impassable' : '' %>"
                     style="color: <%= cell.color %>;"
                     title="<%= cell.label %> [<%= cell.x %>, <%= cell.y %>]">
                  <%= cell.symbol %>
                </div>
              <% }); %>
            </div>
          <% }); %>
        </div>

        <div class="minimap-legend">
          <span><strong>@</strong> Hero</span>
          <span><strong>🏰</strong> City</span>
          <span><strong>🌲</strong> Forest</span>
          <span><strong>🌫️</strong> Swamp</span>
          <span><strong>🌴</strong> Jungle</span>
          <span><strong>🌾</strong> Plains</span>
        </div>
      </div>

      <!-- Character Status Sheet -->
      <div class="character-sheet-card">
        <div class="character-card-header">
          <div>
            <div class="char-hero-name"><%= character.name %></div>
            <div class="char-hero-class"><%= character.class %> • Level <%= character.level %></div>
          </div>
        </div>

        <div class="vitals-grid">
          <div class="vital-box">
            <div class="vital-header-row">
              <div class="vital-label">Vitality (HP)</div>
              <div class="vital-value hp"><%= character.current_hp %> / <%= character.max_hp %></div>
            </div>
            <% const hpPercent = Math.min(100, Math.max(0, Math.round((character.current_hp / character.max_hp) * 100))); %>
            <div class="vital-gauge-track" title="HP: <%= hpPercent %>%">
              <div class="vital-gauge-bar hp-fill <%= hpPercent <= 25 ? 'critical' : (hpPercent <= 50 ? 'wounded' : 'healthy') %>" style="width: <%= hpPercent %>%;"></div>
            </div>
          </div>
          <div class="vital-box">
            <div class="vital-header-row">
              <div class="vital-label">Gold</div>
              <div class="vital-value gold"><%= character.gold %> <span class="gold-unit">gp</span></div>
            </div>
            <div class="vital-gold-decor">✦ Ancient coin in purse</div>
          </div>
        </div>

        <div class="vitals-grid" style="margin-top: 8px; margin-bottom: 12px;">
          <div class="vital-box">
            <div class="vital-header-row">
              <div class="vital-label">Healing Potions</div>
              <div class="vital-value" style="color: #7ce;"><%= safePotionCount %></div>
            </div>
            <div class="vital-gold-decor">🧪 Minor Elixir (1d8+1 HP)</div>
          </div>
          <div class="vital-box">
            <div class="vital-header-row">
              <div class="vital-label">Weapon / Armor</div>
              <div class="vital-value" style="font-size: 0.9rem; color: var(--text-light);"><%= (safeEquipment && safeEquipment.weapon) ? safeEquipment.weapon.name : 'Bare Hands' %></div>
            </div>
            <div class="vital-gold-decor">🛡️ <%= (safeEquipment && safeEquipment.armor) ? safeEquipment.armor.name : 'Unarmored' %></div>
          </div>
        </div>

        <!-- Ability Scores Table -->
        <table class="stats-table">
          <thead>
            <tr>
              <th class="stat-th-lbl">Attribute</th>
              <th class="stat-th-num">Score</th>
              <th class="stat-th-mod">d20 Mod</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="stat-lbl">STR (Strength)</td>
              <td class="stat-num"><%= character.strength %></td>
              <td class="stat-mod <%= modifiers.strength.startsWith('+') && modifiers.strength !== '+0' ? 'positive' : (modifiers.strength.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.strength %></td>
            </tr>
            <tr>
              <td class="stat-lbl">CON (Constitution)</td>
              <td class="stat-num"><%= character.constitution %></td>
              <td class="stat-mod <%= modifiers.constitution.startsWith('+') && modifiers.constitution !== '+0' ? 'positive' : (modifiers.constitution.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.constitution %></td>
            </tr>
            <tr>
              <td class="stat-lbl">DEX (Dexterity)</td>
              <td class="stat-num"><%= character.dexterity %></td>
              <td class="stat-mod <%= modifiers.dexterity.startsWith('+') && modifiers.dexterity !== '+0' ? 'positive' : (modifiers.dexterity.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.dexterity %></td>
            </tr>
            <tr>
              <td class="stat-lbl">INT (Intelligence)</td>
              <td class="stat-num"><%= character.intelligence %></td>
              <td class="stat-mod <%= modifiers.intelligence.startsWith('+') && modifiers.intelligence !== '+0' ? 'positive' : (modifiers.intelligence.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.intelligence %></td>
            </tr>
            <tr>
              <td class="stat-lbl">WIS (Wisdom)</td>
              <td class="stat-num"><%= character.wisdom %></td>
              <td class="stat-mod <%= modifiers.wisdom.startsWith('+') && modifiers.wisdom !== '+0' ? 'positive' : (modifiers.wisdom.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.wisdom %></td>
            </tr>
            <tr>
              <td class="stat-lbl">CHA (Charisma)</td>
              <td class="stat-num"><%= character.charisma %></td>
              <td class="stat-mod <%= modifiers.charisma.startsWith('+') && modifiers.charisma !== '+0' ? 'positive' : (modifiers.charisma.startsWith('-') ? 'negative' : 'neutral') %>"><%= modifiers.charisma %></td>
            </tr>
          </tbody>
        </table>

        <!-- Navigation Tabs for Inventory / Equipment -->
        <div class="tabs-container">
          <button type="button" class="tab-btn active">Status</button>
          <button type="button" class="tab-btn" onclick="alert('Inventory unlocks in Phase 4');">Inventory</button>
          <button type="button" class="tab-btn" onclick="alert('Equipment interface unlocks in Phase 4');">Equipment</button>
        </div>
        <div class="tab-content">
          <span>XP: <strong><%= character.xp %></strong></span>
          <span class="status-alive-badge">● Alive</span>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
