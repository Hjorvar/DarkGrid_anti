rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: /server_state/{document=**}
// Description: Authoritative server-side relational state synced by the Node.js backend.
// Access: Strictly locked out from all browser/client reads and writes.
//
// Collection: /world_state/{docId}
// Document ID: State key (e.g., 'config', 'global', 'counters')
// Fields:
//   - server_authoritative: bool (when true on /world_state/config, locks out client gameplay writes)
// Access: Authenticated read-only; client writes are strictly forbidden.
//
// Collection: /users/{userId}
// Document ID: Firebase Auth UID
// Fields:
//   - uid: string (optional, must match request.auth.uid, immutable)
//   - username: string (required, 1..50 chars, immutable on update)
//   - createdAt / created_at: timestamp or string (optional, immutable on update)
//   - updatedAt / updated_at: timestamp or string (optional)
//
// Collection: /usernames/{username}
// Document ID: Lowercase username string (1..50 chars)
// Fields:
//   - uid: string (required, must match request.auth.uid, immutable)
//   - username: string (optional, 1..50 chars, immutable)
//   - createdAt / created_at: timestamp or string (optional, immutable)
//
// Collection: /characters/{characterId}
// Document ID: Character ID
// Fields:
//   - user_id: string (required, must match request.auth.uid, immutable)
//   - name: string (required, 1..50 chars)
//   - class: string (required, in ['FIGHTER', 'RANGER', 'CLERIC'])
//   - level: int (optional, 1..20)
//   - xp, gold: number (optional, 0..10000000)
//   - current_hp: number (optional, 0..10000)
//   - max_hp: number (optional, 1..10000)
//   - is_alive: int or bool (optional, monotonic: 0 cannot revert to non-zero)
//   - inventory_json, equipment_json: string (optional, <= 50000 chars)
//
// Collection: /encounters/{encounterId}
// Document ID: Encounter ID or user UID
// Fields:
//   - user_id: string (required, must match request.auth.uid, immutable)
//   - character_id: int or string (required, immutable)
//   - status: string (optional, in ['DISCOVERED', 'IN_COMBAT', 'VICTORY', 'DEFEAT', 'ESCAPED', 'IGNORED'])
//   - combat_state_json: string (optional, <= 50000 chars)
//
// Collection: /persistent_monsters/{pmId}
// Document ID: Persistent monster instance ID
// Fields:
//   - tile_id: int or string (required)
//   - monster_id: int or string (required, immutable)
//   - status: string (required, in ['ACTIVE', 'DEFEATED'], monotonic: DEFEATED is final)
//   - held_gold, gold_held: number (optional, 0..10000000)
//   - current_hp, max_hp: number (optional, 0..100000)
//   - items_held_json: string (optional, <= 50000 chars)
//
// Collection: /market_listings/{listingId}
// Document ID: Market listing ID
// Fields:
//   - item_instance_id, item_definition_id, item_id: int or string (optional)
//   - price: number (optional, 0..10000000)
//   - status: string (optional, in ['ACTIVE', 'SOLD', 'WITHDRAWN', 'CANCELLED'], monotonic: SOLD is final)
//
// Collection: /hunting_contracts/{contractId}
// Document ID: Hunting contract ID
// Fields:
//   - user_id: string (required, must match request.auth.uid, immutable)
//   - character_id: int or string (required, immutable)
//   - status: string (required, in ['AVAILABLE', 'ACTIVE', 'READY_TO_CLAIM', 'COMPLETED', 'ABANDONED', 'FAILED'], monotonic: COMPLETED is final)
//   - reward_gold: number (required, 1..1000000)
//   - custom_name, title, description: string (optional, bounded length)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isUserIdOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function userIdUnchanged() {
      return ('user_id' in request.resource.data) &&
        request.resource.data.user_id is string &&
        request.resource.data.user_id == request.auth.uid;
    }

    function userIdNotModified() {
      return ('user_id' in request.resource.data) &&
        request.resource.data.user_id == resource.data.user_id;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Checks whether direct browser/client gameplay writes are permitted.
    // When /world_state/config has server_authoritative == true, client writes are locked out.
    function isClientWriteAllowed() {
      return !exists(/databases/$(database)/documents/world_state/config) ||
        get(/databases/$(database)/documents/world_state/config).data.server_authoritative != true;
    }

    // ===============================================================
    // Domain Validators (Concise to stay well below 1,000-expression limit)
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields([
          'uid', 'username', 'createdAt', 'created_at', 'updatedAt', 'updated_at'
        ]) &&
        hasRequiredFields(['username']) &&
        validStringLength('username', 1, 50) &&
        uidUnchanged();
    }

    function isValidUsernameMapping(data, usernameDocId) {
      return hasOnlyAllowedFields([
          'uid', 'username', 'createdAt', 'created_at'
        ]) &&
        hasRequiredFields(['uid']) &&
        usernameDocId.size() >= 1 &&
        usernameDocId.size() <= 50 &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        (!('username' in data) || (data.username is string && data.username.size() >= 1 && data.username.size() <= 50));
    }

    function isValidCharacter(data) {
      return hasOnlyAllowedFields([
          'user_id', 'name', 'class', 'level', 'xp', 'gold', 'current_hp', 'max_hp',
          'is_alive', 'status', 'tile_id', 'x', 'y',
          'strength', 'constitution', 'dexterity', 'intelligence', 'wisdom', 'charisma',
          'favored_enemy_type', 'favored_enemy_subtype', 'cleric_heal_uses', 'primary_weapon',
          'killed_by_monster_instance_id', 'killed_by_monster_id', 'killed_by_monster_name',
          'killer_name', 'killer_kills', 'tile_name',
          'equipment_json', 'inventory_json', 'equipment', 'stats', 'inventory', 'items', 'potions',
          'died_at', 'diedAt', 'created_at', 'createdAt', 'updated_at', 'updatedAt'
        ]) &&
        hasRequiredFields(['user_id', 'name', 'class']) &&
        userIdUnchanged() &&
        validStringLength('name', 1, 50) &&
        data['class'] is string &&
        data['class'] in ['FIGHTER', 'RANGER', 'CLERIC'] &&
        (!('level' in data) || (data.level is int && data.level >= 1 && data.level <= 20)) &&
        (!('xp' in data) || ((data.xp is int || data.xp is float) && data.xp >= 0 && data.xp <= 10000000)) &&
        (!('gold' in data) || ((data.gold is int || data.gold is float) && data.gold >= 0 && data.gold <= 10000000)) &&
        (!('current_hp' in data) || ((data.current_hp is int || data.current_hp is float) && data.current_hp >= 0 && data.current_hp <= 10000)) &&
        (!('max_hp' in data) || ((data.max_hp is int || data.max_hp is float) && data.max_hp >= 1 && data.max_hp <= 10000)) &&
        (!('is_alive' in data) || data.is_alive is bool || (data.is_alive is int && data.is_alive in [0, 1])) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 40)) &&
        (!('inventory_json' in data) || data.inventory_json == null || (data.inventory_json is string && data.inventory_json.size() <= 50000));
    }

    function isValidEncounter(data) {
      return hasOnlyAllowedFields([
          'user_id', 'character_id', 'tile_id', 'monster_id', 'monster_instance_id', 'bounty_contract_id',
          'status', 'combat_state_json', 'combat_events_json', 'monster_name', 'tile_name',
          'initiative_winner', 'victory_text', 'combat_round', 'current_monster_hp', 'monster_max_hp',
          'last_health_bracket', 'events', 'combat_events', 'combat_state', 'rewards',
          'created_at', 'createdAt', 'updated_at', 'updatedAt'
        ]) &&
        hasRequiredFields(['user_id', 'character_id']) &&
        userIdUnchanged() &&
        (data.character_id is int || (data.character_id is string && data.character_id.size() >= 1 && data.character_id.size() <= 128)) &&
        (!('status' in data) || (data.status is string && data.status in ['DISCOVERED', 'IN_COMBAT', 'VICTORY', 'DEFEAT', 'ESCAPED', 'IGNORED'])) &&
        (!('combat_state_json' in data) || data.combat_state_json == null || (data.combat_state_json is string && data.combat_state_json.size() <= 50000));
    }

    function isValidPersistentMonster(data) {
      return hasOnlyAllowedFields([
          'id', 'tile_id', 'monster_id', 'status', 'gold_held', 'held_gold',
          'current_hp', 'max_hp', 'kill_count', 'custom_title',
          'items_held_json', 'items_held', 'items',
          'killed_character_id', 'killed_character_name',
          'defeated_by_character_id', 'defeated_by_character_name', 'monster_name',
          'created_at', 'createdAt', 'defeated_at', 'defeatedAt', 'updated_at', 'updatedAt'
        ]) &&
        hasRequiredFields(['tile_id', 'monster_id', 'status']) &&
        (data.tile_id is int || (data.tile_id is string && data.tile_id.size() >= 1 && data.tile_id.size() <= 64)) &&
        (data.monster_id is int || (data.monster_id is string && data.monster_id.size() >= 1 && data.monster_id.size() <= 64)) &&
        data.status is string &&
        data.status in ['ACTIVE', 'DEFEATED'] &&
        (!('held_gold' in data) || ((data.held_gold is int || data.held_gold is float) && data.held_gold >= 0 && data.held_gold <= 10000000)) &&
        (!('current_hp' in data) || ((data.current_hp is int || data.current_hp is float) && data.current_hp >= 0 && data.current_hp <= 100000)) &&
        (!('max_hp' in data) || ((data.max_hp is int || data.max_hp is float) && data.max_hp >= 1 && data.max_hp <= 100000)) &&
        (!('items_held_json' in data) || data.items_held_json == null || (data.items_held_json is string && data.items_held_json.size() <= 50000));
    }

    function isValidMarketListing(data) {
      return hasOnlyAllowedFields([
          'id', 'item_id', 'item_definition_id', 'item_instance_id', 'stock_qty',
          'price', 'resale_price', 'listed_by_character_id', 'seller_character_id',
          'buyer_character_id', 'listed_by_character_name', 'seller_character_name',
          'name', 'category', 'status', 'item',
          'created_at', 'createdAt', 'completed_at', 'completedAt', 'updated_at', 'updatedAt'
        ]) &&
        (!('price' in data) || ((data.price is int || data.price is float) && data.price >= 0 && data.price <= 10000000)) &&
        (!('status' in data) || (data.status is string && data.status in ['ACTIVE', 'SOLD', 'WITHDRAWN', 'CANCELLED']));
    }

    function isValidHuntingContract(data) {
      return hasOnlyAllowedFields([
          'id', 'user_id', 'character_id', 'base_monster_id', 'custom_name', 'title',
          'description', 'region_name', 'target_terrain', 'threat_label', 'boost_type',
          'boost_label', 'boosted_max_hp', 'attack_bonus_mod', 'damage_bonus_mod',
          'reward_gold', 'status', 'created_at_level', 'created_at_encounters',
          'created_at', 'createdAt', 'completed_at', 'completedAt', 'claimed_at', 'claimedAt',
          'updated_at', 'updatedAt'
        ]) &&
        hasRequiredFields(['user_id', 'character_id', 'status', 'reward_gold']) &&
        userIdUnchanged() &&
        (data.character_id is int || (data.character_id is string && data.character_id.size() >= 1 && data.character_id.size() <= 128)) &&
        data.status is string &&
        data.status in ['AVAILABLE', 'ACTIVE', 'READY_TO_CLAIM', 'COMPLETED', 'ABANDONED', 'FAILED'] &&
        (data.reward_gold is int || data.reward_gold is float) &&
        data.reward_gold > 0 &&
        data.reward_gold <= 1000000 &&
        (!('custom_name' in data) || (data.custom_name is string && data.custom_name.size() <= 100)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 0. /server_state/{document=**}
    // Authoritative server-side relational store — never accessible to browser clients.
    match /server_state/{document=**} {
      allow read, write: if false;
    }

    // 1. /users/{userId}
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidUser(request.resource.data) &&
        uidNotModified() &&
        areImmutableFieldsUnchanged(['uid', 'username', 'createdAt', 'created_at']);
      allow delete: if false;
    }

    // 2. /usernames/{username}
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidUsernameMapping(request.resource.data, username);
      allow update: if isDocOwner() &&
        isValidUsernameMapping(request.resource.data, username) &&
        uidNotModified() &&
        areImmutableFieldsUnchanged(['uid', 'username', 'createdAt', 'created_at']);
      allow delete: if false;
    }

    // 3. /characters/{characterId}
    match /characters/{characterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isClientWriteAllowed() &&
        isValidCharacter(request.resource.data);
      allow update: if isUserIdOwner() &&
        isClientWriteAllowed() &&
        userIdNotModified() &&
        isValidCharacter(request.resource.data) &&
        !(resource.data.is_alive == 0 && request.resource.data.is_alive != 0) &&
        areImmutableFieldsUnchanged(['user_id', 'created_at', 'createdAt']);
      allow delete: if false;
    }

    // 4. /encounters/{encounterId}
    match /encounters/{encounterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isClientWriteAllowed() &&
        isValidEncounter(request.resource.data);
      allow update: if isUserIdOwner() &&
        isClientWriteAllowed() &&
        userIdNotModified() &&
        isValidEncounter(request.resource.data) &&
        areImmutableFieldsUnchanged(['user_id', 'character_id', 'created_at', 'createdAt']);
      allow delete: if false;
    }

    // 5. /persistent_monsters/{pmId}
    match /persistent_monsters/{pmId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isClientWriteAllowed() &&
        isValidPersistentMonster(request.resource.data);
      allow update: if isAuthenticated() &&
        isClientWriteAllowed() &&
        isValidPersistentMonster(request.resource.data) &&
        !(resource.data.status == 'DEFEATED' && request.resource.data.status != 'DEFEATED') &&
        areImmutableFieldsUnchanged(['monster_id', 'created_at', 'createdAt']);
      allow delete: if false;
    }

    // 6. /market_listings/{listingId}
    match /market_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isClientWriteAllowed() &&
        isValidMarketListing(request.resource.data);
      allow update: if isAuthenticated() &&
        isClientWriteAllowed() &&
        isValidMarketListing(request.resource.data) &&
        !(resource.data.status == 'SOLD' && request.resource.data.status != 'SOLD') &&
        areImmutableFieldsUnchanged(['created_at', 'createdAt']);
      allow delete: if false;
    }

    // 7. /hunting_contracts/{contractId}
    match /hunting_contracts/{contractId} {
      allow read: if isUserIdOwner();
      allow create: if isAuthenticated() &&
        isClientWriteAllowed() &&
        isValidHuntingContract(request.resource.data);
      allow update: if isUserIdOwner() &&
        isClientWriteAllowed() &&
        userIdNotModified() &&
        isValidHuntingContract(request.resource.data) &&
        !(resource.data.status == 'COMPLETED' && request.resource.data.status != 'COMPLETED') &&
        areImmutableFieldsUnchanged(['user_id', 'character_id', 'created_at', 'createdAt']);
      allow delete: if false;
    }

    // 8. /world_state/{docId}
    // Readable by authenticated clients; never writable by clients so /world_state/config cannot be tampered with.
    match /world_state/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Default Deny for all other paths (including /server_* tables)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
