<%- include('partials/header') %>
<%
  const isAvenged = Boolean(persistentInfo && persistentInfo.isPersistent && persistentInfo.avengedHeroes && persistentInfo.avengedHeroes.length > 0);
  const isPersistent = Boolean(persistentInfo && persistentInfo.isPersistent);
  const isBountyVictory = Boolean(typeof bountyInfo !== 'undefined' && bountyInfo && bountyInfo.isBountyTarget);
%>

<div class="victory-viewport">
  <div class="victory-card <%= isAvenged ? 'is-avenged-victory' : (isPersistent ? 'is-persistent-victory' : (isBountyVictory ? 'is-bounty-victory' : '')) %>">
    
    <!-- Top Sigil & Main Title -->
    <div class="victory-header">
      <div class="victory-sigil">
        <% if (isAvenged) { %>
          <span class="sigil-icon avenged-sigil">⚖️</span>
        <% } else if (isPersistent) { %>
          <span class="sigil-icon persistent-sigil">💀</span>
        <% } else if (isBountyVictory) { %>
          <span class="sigil-icon bounty-sigil">🎯</span>
        <% } else { %>
          <span class="sigil-icon standard-sigil">⚔️</span>
        <% } %>
      </div>

      <% if (isAvenged) { %>
        <h1 class="victory-title avenged-title">A Fallen Hero Avenged</h1>
        <p class="victory-subtitle">
          “The darkness took their life, but today justice was extracted in cold steel.”
        </p>
      <% } else if (isPersistent) { %>
        <h1 class="victory-title persistent-title">Persistent Threat Vanquished</h1>
        <p class="victory-subtitle">
          “An enduring terror that haunted these wilderness trails has at last been eradicated.”
        </p>
      <% } else if (isBountyVictory) { %>
        <h1 class="victory-title bounty-victory-title">BOUNTY TARGET SLAIN</h1>
        <p class="victory-subtitle">
          “The hunted terror lies dead at your feet. Return alive to Oakhaven to claim your warrant.”
        </p>
      <% } else { %>
        <h1 class="victory-title standard-title">VICTORY</h1>
        <p class="victory-subtitle">
          “The shadows recede before your blade. Another horror returns to the dust.”
        </p>
      <% } %>
    </div>

    <!-- Bounty Target Slain Notice (When a Named Hunting Contract quarry is defeated) -->
    <% if (isBountyVictory) { %>
      <div class="victory-bounty-panel" role="status">
        <div class="bounty-panel-header">
          <span class="bounty-badge-icon">🎯</span>
          <span class="bounty-badge-label">Watcher's Warrant Fulfilled: <%= bountyInfo.contractTitle %></span>
        </div>
        <p class="bounty-return-notice">
          You have slain <strong><%= bountyInfo.customName || cleanMonsterName %></strong><%= (typeof cleanBaseMonsterName !== 'undefined' && cleanBaseMonsterName && cleanBaseMonsterName !== cleanMonsterName) ? (' (' + cleanBaseMonsterName + ')') : '' %>!
          Return alive to <strong>Oakhaven</strong> to collect your <strong><%= bountyInfo.rewardGold %> Gold</strong> bounty reward from the Watchers.
        </p>
      </div>
    <% } %>

    <!-- Avenged Heroes Memorial (When persistent monster killed previous hero) -->
    <% if (isAvenged) { %>
      <div class="victory-avenged-panel">
        <div class="avenged-panel-header">
          <span class="avenged-badge-icon">🛡️</span>
          <span class="avenged-badge-label">Honored Fallen of Darkgrid</span>
        </div>
        <div class="avenged-hero-list">
          <% persistentInfo.avengedHeroes.forEach(hero => { %>
            <div class="avenged-hero-item">
              <span class="avenged-hero-name"><strong><%= hero.name %></strong></span>
              <span class="avenged-hero-meta"><%= hero.class %> • Level <%= hero.level %></span>
              <% if (hero.died_at) { %>
                <span class="avenged-hero-date">Fell in battle: <%= hero.died_at %></span>
              <% } %>
            </div>
          <% }); %>
        </div>
        <p class="avenged-reclamation-text">
          Their stolen gold and preserved belongings have been reclaimed from the creature's lair.
        </p>
      </div>
    <% } %>

    <!-- Defeated Monster Showcase -->
    <div class="victory-monster-section">
      <div class="victory-monster-headline">
        <span class="monster-symbol-badge" style="color: <%= monsterColor %>;">
          [<%= monsterSymbol %>]
        </span>
        <h2 class="victory-monster-name"><%= cleanMonsterName %></h2>
        <% if (isBountyVictory) { %>
          <span class="bounty-target-badge">🎯 Wanted Quarry</span>
        <% } %>
      </div>

      <!-- Monster Artwork Frame -->
      <div class="victory-art-container">
        <div class="victory-art-frame <%= isBountyVictory ? 'bounty-art-frame' : '' %>">
          <% if (imageUrl) { %>
            <img src="<%= imageUrl %>" alt="Defeated <%= cleanMonsterName %>" class="victory-art-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div class="victory-placeholder" style="display: none;">
              <div class="placeholder-rune">ᚱ</div>
              <div class="placeholder-symbol" style="color: <%= monsterColor %>;"><%= monsterSymbol %></div>
              <div class="placeholder-label"><%= cleanMonsterName %></div>
              <div class="placeholder-sublabel">Vanquished Threat</div>
            </div>
          <% } else { %>
            <div class="victory-placeholder">
              <div class="placeholder-rune">ᚱ</div>
              <div class="placeholder-symbol" style="color: <%= monsterColor %>;"><%= monsterSymbol %></div>
              <div class="placeholder-label"><%= cleanMonsterName %></div>
              <div class="placeholder-sublabel">Vanquished Threat</div>
            </div>
          <% } %>
          <% if (typeof isDefeatedArt !== 'undefined' && isDefeatedArt) { %>
            <div class="victory-defeated-badge" title="Vanquished in Combat">Vanquished</div>
          <% } %>
          <div class="victory-art-vignette"></div>
        </div>
      </div>

      <!-- Defeat Narrative Description (descriptions['9_dead']) -->
      <div class="victory-defeat-narrative">
        <span class="narrative-quote-glyph">“</span>
        <p class="narrative-quote-body"><%= defeatDescription %></p>
        <span class="narrative-quote-glyph">”</span>
      </div>
    </div>

    <!-- Level Up Banner (If hero leveled up from this fight) -->
    <% if (leveledUp) { %>
      <div class="victory-levelup-banner" role="status">
        <div class="levelup-crown">⚜️ LEVEL UP! ⚜️</div>
        <div class="levelup-heading">You have ascended to <strong>Level <%= newLevel %></strong>!</div>
        <div class="levelup-details">
          Maximum Vitality permanently increased by <strong>+<%= hpGain %> HP</strong>
        </div>
      </div>
    <% } %>

    <!-- Spoils of Victory (Rewards Panel) -->
    <div class="victory-rewards-panel">
      <div class="rewards-panel-title">
        <span><%= isAvenged ? 'Reclaimed Spoils & Rewards' : 'Spoils of Victory' %></span>
      </div>

      <% if (resolvedByOther) { %>
        <div class="resolved-by-other-notice">
          Another champion struck the killing blow before you. The creature was already vanquished.
        </div>
      <% } else { %>
        <div class="rewards-stats-grid">
          <!-- Experience Card -->
          <div class="reward-card xp-card">
            <span class="reward-icon">✨</span>
            <div class="reward-text-group">
              <span class="reward-label">Experience Gained</span>
              <strong class="reward-value xp-value">+<%= xpAwarded %> XP</strong>
            </div>
          </div>

          <!-- Gold Card -->
          <div class="reward-card gold-card">
            <span class="reward-icon">🪙</span>
            <div class="reward-text-group">
              <span class="reward-label"><%= isAvenged ? 'Gold Recovered' : 'Gold Recovered' %></span>
              <strong class="reward-value gold-value">+<%= goldLooted %> gp</strong>
            </div>
          </div>
        </div>

        <!-- Items Recovered Section -->
        <% if (lootedItems && lootedItems.length > 0) { %>
          <div class="victory-loot-section">
            <div class="loot-section-header">
              <span class="loot-header-icon">📦</span>
              <span><%= isAvenged ? 'Relics & Gear Recovered' : 'Items Recovered' %> (<%= lootedItems.length %>)</span>
            </div>
            <div class="victory-loot-grid">
              <% lootedItems.forEach(item => { %>
                <div class="victory-loot-badge">
                  <span class="loot-badge-glyph">🗡️</span>
                  <span class="loot-badge-name"><%= item %></span>
                </div>
              <% }); %>
            </div>
          </div>
        <% } else { %>
          <div class="victory-loot-empty">
            <span class="loot-empty-icon">🍃</span>
            <span class="loot-empty-text">No items were found amongst the remains.</span>
          </div>
        <% } %>
      <% } %>
    </div>

    <!-- Character Vitality Summary -->
    <div class="victory-hero-summary">
      <div class="hero-summary-row">
        <span>Hero: <strong style="color: var(--text-heading);"><%= character.name %></strong> (<%= character.class %> • Level <%= character.level %>)</span>
        <span>Vitality: <strong style="color: var(--accent-moss-bright);"><%= character.current_hp %> / <%= character.max_hp %> HP</strong></span>
        <span>Current Purse: <strong style="color: var(--accent-gold);"><%= character.gold %> gp</strong></span>
      </div>
    </div>

    <!-- Full Battle Chronicle (Single-click toggle) -->
    <%
      const safeCombatEvents = (typeof combatEvents !== 'undefined' && Array.isArray(combatEvents))
        ? combatEvents.filter(ev => ev.event_type !== 'CONDITION')
        : [];
    %>
    <% if (safeCombatEvents.length > 0) { %>
      <div class="post-battle-log-section" style="margin-bottom: 24px; text-align: left;">
        <button type="button"
                class="btn btn-secondary post-battle-log-toggle"
                id="btn-toggle-battle-log"
                aria-expanded="false"
                aria-controls="post-battle-log-panel"
                onclick="toggleBattleChronicle()"
                style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; font-size: 0.9rem; border-color: var(--border-gold);">
          <span>📜</span>
          <span id="battle-log-toggle-label">Read Full Battle Record (<%= encounter.combat_round || 1 %> <%= (encounter.combat_round || 1) === 1 ? 'Round' : 'Rounds' %>)</span>
          <span id="battle-log-toggle-chevron" style="font-size: 0.75rem; transition: transform 0.2s;">▼</span>
        </button>

        <div id="post-battle-log-panel"
             class="post-battle-log-panel"
             hidden
             style="margin-top: 10px; background: rgba(10, 12, 16, 0.95); border: 1px solid var(--border-gold); border-radius: 6px; padding: 14px 16px; max-height: 360px; overflow-y: auto; box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.7);">
          <%
            let lastRenderedRound = null;
            safeCombatEvents.forEach(function(ev) {
              const rNum = Number(ev.round_number || 1);
              if (rNum !== lastRenderedRound) {
                lastRenderedRound = rNum;
          %>
                <div class="post-battle-round-divider" style="font-family: var(--font-serif); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-gold); border-bottom: 1px solid rgba(197, 160, 89, 0.25); padding-bottom: 3px; margin: <%= rNum > 1 ? '12px' : '0' %> 0 6px 0; font-weight: 700;">
                  Round <%= rNum %>
                </div>
          <%  } %>
              <div class="combat-event-row <%= (ev.event_type || '').toLowerCase() %>" style="margin-bottom: 4px; font-size: 0.85rem; line-height: 1.45;">
                <% if (ev.event_type === 'OPENING_SHOT') { %>🏹 <% } %>
                <% if (ev.event_type === 'HERO_ATTACK') { %>⚔️ <% } %>
                <% if (ev.event_type === 'MONSTER_ATTACK') { %>🩸 <% } %>
                <% if (ev.event_type === 'MONSTER_ABILITY') { %>⚡ <% } %>
                <% if (ev.event_type === 'STATUS_EFFECT') { %>☠️ <% } %>
                <% if (ev.event_type === 'POTION_USED') { %>🧪 <% } %>
                <% if (ev.event_type === 'FLEE') { %>🏃 <% } %>
                <% if (ev.event_type === 'MONSTER_CONDITION') { %>⚠️ <% } %>
                <% if (ev.event_type === 'VICTORY') { %>🏆 <% } %>
                <% if (ev.event_type === 'LEVEL_UP') { %>⚜️ <% } %>
                <span><%= ev.public_text %></span>
              </div>
          <% }); %>
        </div>
      </div>

      <script>
        function toggleBattleChronicle() {
          var panel = document.getElementById('post-battle-log-panel');
          var btn = document.getElementById('btn-toggle-battle-log');
          var chevron = document.getElementById('battle-log-toggle-chevron');
          if (!panel || !btn) return;
          var isHidden = panel.hasAttribute('hidden');
          if (isHidden) {
            panel.removeAttribute('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
          } else {
            panel.setAttribute('hidden', '');
            btn.setAttribute('aria-expanded', 'false');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
          }
        }
      </script>
    <% } %>

    <!-- Action Button (Continue Exploring) -->
    <div class="victory-actions">
      <a href="/game" class="btn btn-primary victory-continue-btn" id="btn-continue-exploring">
        Continue Exploring ➔
      </a>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
