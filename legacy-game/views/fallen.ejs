<%- include('partials/header') %>

<div class="auth-card fallen-card" style="max-width: 650px; text-align: center; margin: 40px auto; border: 1px solid var(--accent-crimson); box-shadow: 0 0 30px rgba(180, 20, 20, 0.25);">
  <div style="font-size: 3rem; margin-bottom: 12px; color: var(--accent-crimson);">☠️</div>
  <h1 style="color: var(--accent-crimson); font-family: var(--font-display); letter-spacing: 2px; margin-bottom: 8px;">
    A Champion Has Fallen
  </h1>
  <p style="color: var(--text-muted); font-style: italic; margin-bottom: 24px;">
    “The darkness does not bargain. It merely claims what is left behind.”
  </p>

  <div style="background: rgba(0, 0, 0, 0.4); border: 1px solid var(--border-dark); border-radius: 6px; padding: 20px; margin-bottom: 28px; text-align: left;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid var(--border-dark); padding-bottom: 8px;">
      <span style="color: var(--text-muted);">Hero Name:</span>
      <strong style="color: var(--text-light);"><%= fallen.name %></strong>
    </div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid var(--border-dark); padding-bottom: 8px;">
      <span style="color: var(--text-muted);">Class & Rank:</span>
      <span style="color: var(--accent-gold);"><%= fallen.class %> • Level <%= fallen.level %></span>
    </div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid var(--border-dark); padding-bottom: 8px;">
      <span style="color: var(--text-muted);">Fallen At:</span>
      <span style="color: var(--text-light);"><%= fallen.tile_name || 'The Wilderness' %></span>
    </div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid var(--border-dark); padding-bottom: 8px;">
      <span style="color: var(--text-muted);">Slain By:</span>
      <strong style="color: var(--accent-crimson);"><%= fallen.killer_name || 'A Savage Horror' %></strong>
    </div>
    <div style="display: flex; justify-content: space-between;">
      <span style="color: var(--text-muted);">Time of Passing:</span>
      <span style="color: var(--text-light); font-size: 0.85rem;"><%= fallen.died_at || 'Just now' %></span>
    </div>
  </div>

  <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 24px;">
    Permadeath is absolute in Darkgrid. The creature that ended your life now prowls the wilderness as a <strong>Persistent Monster</strong>, guarding the spoils of your fallen champion.
  </p>

  <!-- Full Battle Chronicle (Single-click toggle) -->
  <%
    const safeCombatEvents = (typeof combatEvents !== 'undefined' && Array.isArray(combatEvents))
      ? combatEvents.filter(ev => ev.event_type !== 'CONDITION')
      : [];
  %>
  <% if (safeCombatEvents.length > 0) { %>
    <div class="post-battle-log-section" style="margin-bottom: 26px; text-align: left;">
      <button type="button"
              class="btn btn-secondary post-battle-log-toggle"
              id="btn-toggle-battle-log"
              aria-expanded="false"
              aria-controls="post-battle-log-panel"
              onclick="toggleBattleChronicle()"
              style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; font-size: 0.9rem; border-color: var(--border-crimson);">
        <span>📜</span>
        <span id="battle-log-toggle-label">Read Final Battle Record</span>
        <span id="battle-log-toggle-chevron" style="font-size: 0.75rem; transition: transform 0.2s;">▼</span>
      </button>

      <div id="post-battle-log-panel"
           class="post-battle-log-panel"
           hidden
           style="margin-top: 10px; background: rgba(10, 12, 16, 0.95); border: 1px solid var(--border-crimson); border-radius: 6px; padding: 14px 16px; max-height: 360px; overflow-y: auto; box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.7);">
        <%
          let lastRenderedRound = null;
          safeCombatEvents.forEach(function(ev) {
            const rNum = Number(ev.round_number || 1);
            if (rNum !== lastRenderedRound) {
              lastRenderedRound = rNum;
        %>
              <div class="post-battle-round-divider" style="font-family: var(--font-serif); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-crimson-bright); border-bottom: 1px solid rgba(158, 42, 43, 0.35); padding-bottom: 3px; margin: <%= rNum > 1 ? '12px' : '0' %> 0 6px 0; font-weight: 700;">
                Round <%= rNum %>
              </div>
        <%  } %>
            <div class="combat-event-row <%= (ev.event_type || '').toLowerCase() %>" style="margin-bottom: 4px; font-size: 0.85rem; line-height: 1.45;">
              <% if (ev.event_type === 'OPENING_SHOT') { %>🏹 <% } %>
              <% if (ev.event_type === 'HERO_ATTACK') { %>⚔️ <% } %>
              <% if (ev.event_type === 'MONSTER_ATTACK') { %>🩸 <% } %>
              <% if (ev.event_type === 'MONSTER_ABILITY') { %>⚡ <% } %>
              <% if (ev.event_type === 'STATUS_EFFECT') { %>☠️ <% } %>
              <% if (ev.event_type === 'POTION_USED') { %>🧪 <% } %>
              <% if (ev.event_type === 'FLEE') { %>🏃 <% } %>
              <% if (ev.event_type === 'MONSTER_CONDITION') { %>⚠️ <% } %>
              <% if (ev.event_type === 'DEATH') { %>☠️ <% } %>
              <span><%= ev.public_text %></span>
            </div>
        <% }); %>
      </div>
    </div>

    <script>
      function toggleBattleChronicle() {
        var panel = document.getElementById('post-battle-log-panel');
        var btn = document.getElementById('btn-toggle-battle-log');
        var chevron = document.getElementById('battle-log-toggle-chevron');
        if (!panel || !btn) return;
        var isHidden = panel.hasAttribute('hidden');
        if (isHidden) {
          panel.removeAttribute('hidden');
          btn.setAttribute('aria-expanded', 'true');
          if (chevron) chevron.style.transform = 'rotate(180deg)';
        } else {
          panel.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.style.transform = 'rotate(0deg)';
        }
      }
    </script>
  <% } %>

  <div>
    <a href="/character/create" class="btn btn-primary" style="padding: 12px 32px; font-size: 1.1rem; display: inline-block; text-decoration: none;">
      Venture Forth Anew (Create Hero)
    </a>
  </div>
</div>

<%- include('partials/footer') %>
